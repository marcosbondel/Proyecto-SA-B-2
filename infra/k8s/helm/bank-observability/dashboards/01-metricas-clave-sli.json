            "uid": "bank-prometheus"
          },
          "expr": "sli:kyc_time_to_decision:seconds_p95{environment=\"$environment\"}",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "description": "El percentil que §4.1 pide para Customer Service. Ventana de 6 h: las decisiones son pocas y con 5 m el cuantil sale vacío casi siempre."
    },
