            "uid": "bank-prometheus"
          },
          "expr": "sum(sli:broker_consumer_lag:messages{environment=\"$environment\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 41,
      "type": "stat",
      "title": "Entregado sin confirmar (unacked)",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
