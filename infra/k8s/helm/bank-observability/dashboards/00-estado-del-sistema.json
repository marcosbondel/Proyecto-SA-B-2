{
  "uid": "bank-estado",
  "title": "Bank USAC · Estado del sistema",
  "tags": [
    "bank-usac",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Lo primero que se mira. Los cuatro SLO medidos, el throughput que les da sentido y los errores visibles desde fuera.",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "bank-prometheus"
        },
        "enable": true,
        "expr": "max by (namespace, replicaset) (time() - kube_replicaset_created{namespace=~\"$namespace\"} < 180)",
        "iconColor": "light-blue",
        "name": "Despliegues",
        "titleFormat": "Despliegue: ReplicaSet nuevo {{replicaset}}",
        "textFormat": "namespace {{namespace}} · sólo un rollout crea un ReplicaSet; un escalado del HPA no",
        "step": "2m"
      },
      {
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Releases",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "release"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "bank-prometheus"
        },
        "definition": "label_values(environment)",
        "includeAll": false,
        "label": "Entorno",
        "name": "environment",
        "query": {
          "query": "label_values(environment)",
          "refId": "env"
        },
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "bank-prometheus"
        },
        "definition": "label_values(sli:namespace_environment:info{environment=\"$environment\"}, namespace)",
        "description": "El namespace del entorno elegido, leído de la regla sli:namespace_environment:info. En la nube es el mismo nombre (dev, prod); en kind el entorno local vive en bank-usac.",
        "hide": 2,
        "includeAll": false,
        "label": "Namespace",
        "name": "namespace",
        "query": {
          "query": "label_values(sli:namespace_environment:info{environment=\"$environment\"}, namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilidad del Gateway (SLO-27 ≥ 99 %)",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "expr": "slo:gateway_availability:ratio_rate5m{environment=\"$environment\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Respuestas distintas de 5xx, sin contar los sondeos del kubelet."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Transferencias < 5 s (SLO-2 ≥ 95 %)",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "expr": "slo:transfer_under_5s:ratio_rate5m{environment=\"$environment\"}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Entregas fuera de la cola muerta (SLO-1 ≥ 99 %)",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "expr": "slo:messages_not_dead_lettered:ratio_rate5m{environment=\"$environment\"}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Depósitos interbancarios aceptados (SLO-28 ≥ 95 %)",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "expr": "slo:interbank_accepted:ratio_rate5m{environment=\"$environment\"}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput por servicio: consumido y publicado (mensajes/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "expr": "sli:throughput_by_service:rate5m{environment=\"$environment\"}",
          "legendFormat": "{{service_name}} · consumido",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "expr": "sli:published_by_service:rate5m{environment=\"$environment\"}",
          "legendFormat": "{{service_name}} · publicado",
          "refId": "B"
        }
      ],
      "description": "Lo consumido y lo publicado, por servicio. Con una sola de las dos, un productor que deja de publicar y un consumidor que deja de leer se ven igual."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Respuestas 5xx del Gateway por ruta",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "expr": "sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"gateway\", environment=\"$environment\", http_response_status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{http_route}} · {{http_response_status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Réplicas disponibles por componente",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "expr": "sum by (deployment) (kube_deployment_status_replicas_available{namespace=~\"$namespace\"})",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ],
      "description": "Las líneas verticales son despliegues."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Transferencias por resultado final",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "expr": "sum by (result) (rate(bank_transfer_finished_total{environment=\"$environment\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "description": "COMPENSATED no es un fallo del sistema: es el sistema devolviendo el dinero, que es lo que debe hacer."
    }
  ]
}
