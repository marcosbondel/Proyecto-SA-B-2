# Local development stack environment variables.
# Copy this file to .env and replace every placeholder with local values.
# Real credentials MUST NOT be committed.

# -----------------------------------------------------------------------------
# PostgreSQL: Customer Service
# -----------------------------------------------------------------------------
CUSTOMER_POSTGRES_DB=customer
CUSTOMER_POSTGRES_USER=customer_app
CUSTOMER_POSTGRES_PASSWORD=changeme
CUSTOMER_POSTGRES_PORT=5433

# -----------------------------------------------------------------------------
# PostgreSQL: Account Service
# -----------------------------------------------------------------------------
ACCOUNT_POSTGRES_DB=account
ACCOUNT_POSTGRES_USER=account_app
ACCOUNT_POSTGRES_PASSWORD=changeme
ACCOUNT_POSTGRES_PORT=5434

# -----------------------------------------------------------------------------
# PostgreSQL: Transaction Service
# -----------------------------------------------------------------------------
TRANSACTION_POSTGRES_DB=transaction
TRANSACTION_POSTGRES_USER=transaction_app
TRANSACTION_POSTGRES_PASSWORD=changeme
TRANSACTION_POSTGRES_PORT=5435

# -----------------------------------------------------------------------------
# PostgreSQL: Payment Service
# -----------------------------------------------------------------------------
PAYMENT_POSTGRES_DB=payment
PAYMENT_POSTGRES_USER=payment_app
PAYMENT_POSTGRES_PASSWORD=changeme
PAYMENT_POSTGRES_PORT=5436

# -----------------------------------------------------------------------------
# PostgreSQL: Notification & Audit Service
# -----------------------------------------------------------------------------
NOTIFICATION_AUDIT_POSTGRES_DB=notification_audit
NOTIFICATION_AUDIT_POSTGRES_USER=notification_audit_app
NOTIFICATION_AUDIT_POSTGRES_PASSWORD=changeme
NOTIFICATION_AUDIT_POSTGRES_PORT=5437

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=changeme
RABBITMQ_APP_USER=bank_app
RABBITMQ_APP_PASSWORD=changeme
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_APP_USER=bank_app
MINIO_APP_PASSWORD=changeme
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=customer-identity-documents
MINIO_RETENTION_HOURS=24

# -----------------------------------------------------------------------------
# Email delivery (notification-audit-service)
# -----------------------------------------------------------------------------
# `simulated` is the safe local default and does not send email. Set this to
# `resend` only after creating a Resend API key and verifying the sender domain.
NOTIFICATION_CHANNEL=simulated
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM="bonking <no-reply@mail.example.com>"
APP_BASE_URL=http://localhost:3010
RESEND_API_URL=https://api.resend.com/emails
REVEAL_ACTIVATION_LINKS=false

# -----------------------------------------------------------------------------
# Alertas de SLO (Grafana → Gateway → Notification & Audit)
# -----------------------------------------------------------------------------
# Secreto del webhook `POST /api/alerts/slo` (>= 32 caracteres). Vacío = el
# webhook rechaza a todos. En la nube lo pone el pipeline desde el secreto de
# GitHub `ALERT_WEBHOOK_TOKEN`; aquí sólo hace falta para probar alertas a mano.
ALERT_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# Integración interbancaria — contrato v1 oficial (T-60)
# -----------------------------------------------------------------------------
# El acuerdo con el banco pareja vive en github.com/marcosbondel/bank-interbank-contract
# (AGREEMENT.md). Los códigos cumplen ^BANK[0-9]{2}$: el Gateway se niega a
# arrancar con otro formato. BANK99 es el banco pareja simulado de este repo.
INTERBANK_BANK_CODE=BANK02
INTERBANK_PARTNER_BANK_CODE=BANK99

# Las dos llaves del acuerdo (§4), >= 32 caracteres cada una, nunca versionadas:
#   INBOUND  — la que exigimos en `X-Api-Key` a quien nos llama (el mock la manda).
#   OUTBOUND — la que mandamos al llamar al banco pareja (el mock la exige).
# Vacías, los compose usan un valor de desarrollo conocido por los dos lados.
INTERBANK_API_KEY_INBOUND=
INTERBANK_API_KEY_OUTBOUND=

# URL base del banco pareja, con el sufijo /interbank/v1. El callback no se
# configura: se deriva como {URL base}/transfers/{id}/result. Vacía, los compose
# apuntan al mock: http://partner-bank-mock:3021/interbank/v1.
INTERBANK_PARTNER_BASE_URL=

# Monto máximo por operación, en centavos, en los dos sentidos. El contrato fija
# el techo en 10000.00 (1000000); un valor mayor se rechaza al arrancar.
INTERBANK_MAX_AMOUNT_MINOR=1000000

# Sólo para las rutas provisionales /api/interbank/deposits y /callbacks (T-46),
# que el contrato v1 ya no usa. Vacío las mantiene cerradas.
INTERBANK_PARTNER_TOKEN=

# -----------------------------------------------------------------------------
# Banco pareja simulado (apps/partner-bank-mock, perfil `interbank` del compose)
# -----------------------------------------------------------------------------
# Token de su API de administración (`X-Admin-Token`): cambiar el modo en
# caliente, originar depósitos hacia nosotros. Vacío = /admin/* responde 403.
PARTNER_MOCK_ADMIN_TOKEN=
# Modo inicial: ACCEPT | REJECT | TIMEOUT | SLOW | UNAVAILABLE.
PARTNER_CALLBACK_MODE=ACCEPT
PARTNER_CALLBACK_DELAY_MS=1000
PARTNER_CALLBACK_SLOW_MS=10000
# Uno de los siete motivos del contrato.
PARTNER_CALLBACK_REJECT_REASON=ACCOUNT_NOT_FOUND
# Las N primeras operaciones de cada objetivo fallan: result | transfer | status | callback.
PARTNER_CALLBACK_FAIL_COUNT=0
PARTNER_CALLBACK_FAIL_TARGETS=result

# -----------------------------------------------------------------------------
# Fase 3 — monitoreo de cuentas y simulación de fallos
# -----------------------------------------------------------------------------
# AccountAnomalyDetected: más de N operaciones sobre una cuenta en M minutos.
ANOMALY_MAX_OPERATIONS=10
ANOMALY_WINDOW_MINUTES=5
# Valores iniciales del proveedor de pagos simulado. Se cambian en caliente con
# `PUT /api/payments/simulation` (ADMINISTRADOR) sin reiniciar nada.
PAYMENT_SIM_FAILURE_RATE=0
PAYMENT_SIM_TIMEOUT_RATE=0
PAYMENT_SIM_LATENCY_MS=0

# -----------------------------------------------------------------------------
# Datos demo y telemetría
# -----------------------------------------------------------------------------
# Siembra clientes y cuentas demo al arrancar. Sólo crea lo que falta: nunca
# pisa un saldo ni una contraseña existentes.
SEED_DEMO_DATA=true
SEED_PASSWORD=BankUsac#2026
# Collector OTLP. Vacío = los servicios no exportan telemetría.
OTEL_EXPORTER_OTLP_ENDPOINT=
DEPLOYMENT_ENVIRONMENT=local
