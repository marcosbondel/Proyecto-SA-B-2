{
  "name": "bank-usac",
  "version": "0.0.0",
  "private": true,
  "description": "Bank USAC monorepo — API Gateway, web app, five domain microservices, and shared packages.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:contract": "turbo run test --filter=@bank/contracts",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "docker compose -f infra/docker/docker-compose.dev.yml up --build",
    "dev:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "dev:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "dev:host": "turbo run dev",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@bank/tooling": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
