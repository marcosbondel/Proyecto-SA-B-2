{
  "name": "bank-usac",
  "version": "0.0.0",
  "private": true,
  "description": "Bank USAC monorepo \u2014 API Gateway, web app, five domain microservices, and shared packages.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:contract": "pnpm --filter @bank/contracts test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "docker compose -f infra/docker/docker-compose.dev.yml up --build",
    "dev:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "dev:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "dev:host": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "@bank/tooling": "workspace:*",
    "prettier": "catalog:"
  }
}
