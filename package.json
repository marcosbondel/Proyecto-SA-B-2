{
  "name": "bank-usac",
  "version": "0.0.0",
  "private": true,
  "description": "Bank USAC monorepo — API Gateway, web app, five domain microservices, and shared packages.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:contract": "turbo run test --filter=@bank/contracts",
    "test:e2e": "node test/e2e/qa-suite.e2e.mjs",
    "test:e2e:happypath": "node test/e2e/happypath.e2e.mjs",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "docker compose -f infra/docker/docker-compose.dev.yml up --build",
    "dev:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "dev:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "dev:host": "turbo run dev",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "images:build": "./infra/docker/scripts/build-images.sh",
    "images:up": "docker compose -f infra/docker/docker-compose.images.yml up -d",
    "images:down": "docker compose -f infra/docker/docker-compose.images.yml down",
    "images:logs": "docker compose -f infra/docker/docker-compose.images.yml logs -f",
    "images:smoke": "./infra/docker/scripts/smoke-images.sh",
    "images:flow": "./infra/docker/scripts/flow-images.sh"
  },
  "devDependencies": {
    "@bank/tooling": "workspace:*",
    "playwright": "^1.62.1",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
