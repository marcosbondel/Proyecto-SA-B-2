{
  "name": "bank-usac",
  "version": "1.0.0",
  "private": true,
  "description": "Bank USAC monorepo — API Gateway, web app, five domain microservices, and shared packages.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:contract": "turbo run test --filter=@bank/contracts",
    "test:e2e": "node test/e2e/qa-suite.e2e.mjs",
    "test:e2e:all": "node test/e2e/run-all.mjs",
    "test:pyramid": "node test/scripts/pyramid.mjs",
    "test:e2e:happypath": "node test/e2e/happypath.e2e.mjs",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "docker compose -f infra/docker/docker-compose.dev.yml up --build",
    "dev:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "dev:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "dev:host": "turbo run dev",
    "partner:mock": "pnpm --filter partner-bank-mock dev",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "images:build": "./infra/docker/scripts/build-images.sh",
    "images:up": "docker compose -f infra/docker/docker-compose.images.yml up -d",
    "images:down": "docker compose -f infra/docker/docker-compose.images.yml down",
    "images:logs": "docker compose -f infra/docker/docker-compose.images.yml logs -f",
    "images:smoke": "./infra/docker/scripts/smoke-images.sh",
    "images:flow": "./infra/docker/scripts/flow-images.sh",
    "images:trace": "./infra/docker/scripts/trace-images.sh",
    "k8s:cluster": "./infra/k8s/scripts/create-cluster.sh",
    "k8s:cluster:down": "kind delete cluster --name bank-usac",
    "k8s:ips": "./infra/k8s/kind/scripts/discover-external-ips.sh",
    "k8s:install": "./infra/k8s/scripts/install.sh",
    "k8s:forward": "./infra/k8s/scripts/port-forward.sh",
    "k8s:evidence": "./infra/k8s/scripts/capture-evidence.sh",
    "k8s:status": "kubectl get pods,svc --context kind-bank-usac -n bank-usac -o wide",
    "k8s:logs": "kubectl logs --context kind-bank-usac -n bank-usac --tail 200 -f --prefix --all-containers -l app.kubernetes.io/instance=bank-usac --max-log-requests 8",
    "k8s:down": "helm uninstall bank-usac --kube-context kind-bank-usac --namespace bank-usac",
    "obs:check": "./infra/k8s/scripts/check-chart-deps.sh infra/k8s/helm/bank-observability",
    "obs:lint": "helm lint infra/k8s/helm/bank-observability",
    "obs:template": "helm template bank-observability infra/k8s/helm/bank-observability --namespace observability",
    "obs:forward": "kubectl port-forward -n observability svc/grafana 3000:80",
    "obs:kind": "./infra/scripts/cloud/obs-kind.sh",
    "obs:kind:down": "./infra/scripts/cloud/obs-kind.sh --down",
    "cloud:up": "./infra/scripts/cloud/cloud-up.sh",
    "cloud:down": "./infra/scripts/cloud/cloud-down.sh",
    "cloud:cost": "./infra/scripts/cloud/cost-check.sh"
  },
  "devDependencies": {
    "@bank/tooling": "workspace:*",
    "playwright": "^1.62.1",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
