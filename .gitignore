### macOS ###
# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### macOS Patch ###
# iCloud generated files
*.icloud

### Windows ###
# Windows thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Dump file
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

# End of https://www.toptal.com/developers/gitignore/api/windows,macos
### Spec Kit ###
# Catalogo de integraciones: cache local regenerable
.specify/integrations/.cache/

### Node / project-wide build outputs ###
node_modules/
dist/
build/
*.log

# …except a spec's evidence, where the captured output IS the deliverable.
# The existing logs under specs/006-local-dev-infra/evidence/ are tracked only
# because someone remembered `git add -f`; this makes that unnecessary, and
# stops a capture from being silently dropped by the rule above.
!specs/*/evidence/*.log
coverage/
.output/
.nuxt/
.nitro/
.data/
*.tsbuildinfo

# Turborepo's per-package task cache and run logs.
.turbo/

### Local environment ###
# Real values stay out of the repo; the committed templates do not.
.env
.env.*
!.env.example
gcp-sa-key.json
*.key.json

# Generated by `pnpm --filter @bank/contracts schema:emit` from the Zod contracts.
# Regenerable in one command, so the source of truth stays the TypeScript.
apps/packages/contracts/schema/

### Terraform ###
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.tfvars
*.tfvars.json
!*.tfvars.example
# La configuración parcial del backend remoto: el nombre del bucket de estado
# depende del proyecto de GCP, así que no se commitea. La plantilla sí
# (backend.hcl.example). `.terraform.lock.hcl` no se ve afectado.
backend.hcl

# Lo que las corridas de carga de T-51 dejan por el camino: el resumen de k6, su
# salida y los recuentos de antes y después. Los **números** van al postmortem y
# a la evidencia, que es donde alguien los va a leer; el archivo crudo es de una
# corrida concreta en una máquina concreta y no se versiona.
tmp/load/

# Los worktrees que crean los agentes al trabajar en paralelo (`isolation:
# worktree`). Son checkouts completos del repositorio con su propio
# `node_modules`: versionarlos duplicaria el repo dentro de si mismo.
.claude/worktrees/

# Bitacoras de validacion y verificacion local de T-60. Lo que importa de ellas
# pasa a la evidencia de docs/qa/; el log crudo es de una maquina y una corrida.
tmp/t60/
