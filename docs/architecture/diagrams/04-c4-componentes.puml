@startuml 04-c4-componentes

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Diagrama de Componentes - Transaction Service (C4 Nivel 3)
' Microservicio descompuesto: Transaction Service, orquestador de la Saga de transferencia.
' Generado en sincronía exacta con 04-c4-componentes.dsl y 04-c4-componentes.png.

LAYOUT_TOP_DOWN()

AddElementTag("interfaces", $bgColor="#FFFFFF", $fontColor="#1168BD", $borderColor="#1168BD")
AddElementTag("application", $bgColor="#FFFFFF", $fontColor="#EF9425", $borderColor="#EF9425")
AddElementTag("port", $bgColor="#FFFFFF", $fontColor="#EF9425", $borderColor="#EF9425", $borderStyle="dashed")
AddElementTag("domain", $bgColor="#FFFFFF", $fontColor="#398819", $borderColor="#398819")
AddElementTag("infrastructure", $bgColor="#FFFFFF", $fontColor="#C11926", $borderColor="#C11926")
AddElementTag("broker", $bgColor="#FFFFFF", $fontColor="#1168BD", $borderColor="#1168BD")
AddElementTag("database", $bgColor="#FFFFFF", $fontColor="#1168BD", $borderColor="#1168BD")

Container_Ext(rabbitmq, "RabbitMQ", "RabbitMQ 4.3.4-management / AMQP", "Broker central de mensajería asíncrona, fuera de kind.", $tags="broker")
ContainerDb_Ext(transaction_db, "Transaction DB", "PostgreSQL", "Base exclusiva de Transaction Service.", $tags="database")

Container_Boundary(transactionService, "Transaction Service (NestJS)") {

    Boundary(interfaces, "interfaces/") {
        Component(h_transfer, "TransferRequestedHandler", "Consumer AMQP", "Consume transfer.requested | AMQP | comando", $tags="interfaces")
        Component(h_status, "TransactionStatusRequestedHandler", "Consumer AMQP", "Consume transaction.status.requested | AMQP | comando", $tags="interfaces")
        Component(h_list, "TransactionListQueryHandler", "Consumer AMQP", "Consume transaction.list.query | AMQP | consulta", $tags="interfaces")
        Component(h_stats, "TransactionStatsQueryHandler", "Consumer AMQP", "Consume transaction.stats.query | AMQP | consulta", $tags="interfaces")
        Component(h_kyc_checked, "CustomerKycCheckedHandler", "Consumer AMQP", "Consume customer.kyc.checked | AMQP | evento", $tags="interfaces")
        Component(h_debited, "AccountDebitedHandler", "Consumer AMQP", "Consume account.debited | AMQP | evento", $tags="interfaces")
        Component(h_debit_rejected, "AccountDebitRejectedHandler", "Consumer AMQP", "Consume account.debit.rejected | AMQP | evento", $tags="interfaces")
        Component(h_paid, "PaymentSucceededHandler", "Consumer AMQP", "Consume payment.succeeded | AMQP | evento", $tags="interfaces")
        Component(h_pay_failed, "PaymentFailedHandler", "Consumer AMQP", "Consume payment.failed | AMQP | evento", $tags="interfaces")
        Component(h_attempt_failed, "PaymentAttemptFailedHandler", "Consumer AMQP", "Consume payment.attempt.failed | AMQP | evento", $tags="interfaces")
        Component(h_credited, "AccountCreditedHandler", "Consumer AMQP", "Consume account.credited | AMQP | evento", $tags="interfaces")
        Component(h_credit_rejected, "AccountCreditRejectedHandler", "Consumer AMQP", "Consume account.credit.rejected | AMQP | evento", $tags="interfaces")
        Component(h_compensated, "AccountDebitCompensatedHandler", "Consumer AMQP", "Consume account.debit.compensated | AMQP | evento", $tags="interfaces")
        Component(health, "HealthController", "HTTP Controller", "Health/readiness checks | HTTP | síncrono", $tags="interfaces")
    }

    Boundary(application, "application/") {
        Component(uc_request_transfer, "RequestTransferUseCase", "Caso de uso", "Abre la Saga: crea Transaction en PENDING", $tags="application")
        Component(uc_get_status, "GetTransactionStatusUseCase", "Caso de uso", "Responde transaction.status.replied", $tags="application")
        Component(uc_list_tx, "ListTransactionsUseCase", "Caso de uso", "Consulta historial con filtros (cuenta, estado, fechas)", $tags="application")
        Component(uc_get_stats, "GetTransactionStatsUseCase", "Caso de uso", "Métricas y volumen para el monitor de la Saga", $tags="application")
        Component(uc_record_attempt, "RecordPaymentAttemptUseCase", "Caso de uso", "Registra intentos de la escalera de reintentos", $tags="application")
        Component(saga, "SagaCoordinator", "Handlers de la Saga", "Reacciona a eventos de KYC, Account y Payment; decide siguiente paso o compensación", $tags="application")
        Component(port_repo, "TransactionRepositoryPort", "Puerto (interfaz)", "Contrato de persistencia de Transaction", $tags="port")
        Component(port_publisher, "EventPublisherPort", "Puerto (interfaz)", "Contrato de publicación de comandos/eventos", $tags="port")
    }

    Boundary(domain, "domain/") {
        Component(txEntity, "Transaction", "Entidad + Máquina de Estados", "PENDING/DEBITING/PAYMENT_PENDING/COMPLETED/FAILED/COMPENSATED;", $tags="domain")
    }

    Boundary(infrastructure, "infrastructure/") {
        Component(pub_adapter, "RabbitMqPublisherAdapter", "Adaptador de publicación", "Implementa EventPublisherPort", $tags="infrastructure")
        Component(sub_adapter, "RabbitMqConsumerAdapter", "Adaptador de consumo", "Enruta deliveries a los handlers de interfaces/", $tags="infrastructure")
        Component(amqp, "AmqpConnectionManager", "Integración con el broker", "Conexión AMQP, ack manual, DLQ", $tags="infrastructure")
        Component(repo_impl, "TransactionPostgresRepository", "Adaptador de persistencia", "Implementa TransactionRepositoryPort sobre PostgreSQL", $tags="infrastructure")
        Component(outbox_relay, "OutboxRelay", "Outbox Scheduler", "Barrido periódico que lee eventos pendientes del outbox y los publica en RabbitMQ (TD-031)", $tags="infrastructure")
    }
}

' --- interfaces/ -> application/ ---
Rel(h_transfer, uc_request_transfer, "invoca", "llamada interna | síncrono")
Rel(h_status, uc_get_status, "invoca", "llamada interna | síncrono")
Rel(h_list, uc_list_tx, "invoca", "llamada interna | síncrono")
Rel(h_stats, uc_get_stats, "invoca", "llamada interna | síncrono")
Rel(h_kyc_checked, saga, "invoca", "llamada interna | síncrono")
Rel(h_debited, saga, "invoca", "llamada interna | síncrono")
Rel(h_debit_rejected, saga, "invoca", "llamada interna | síncrono")
Rel(h_paid, saga, "invoca", "llamada interna | síncrono")
Rel(h_pay_failed, saga, "invoca", "llamada interna | síncrono")
Rel(h_attempt_failed, uc_record_attempt, "invoca", "llamada interna | síncrono")
Rel(h_credited, saga, "invoca", "llamada interna | síncrono")
Rel(h_credit_rejected, saga, "invoca", "llamada interna | síncrono")
Rel(h_compensated, saga, "invoca", "llamada interna | síncrono")

' --- application/ -> domain/ ---
Rel(uc_request_transfer, txEntity, "llamada interna | síncrono")
Rel(saga, txEntity, "aplica transición válida", "llamada interna | síncrono")

' --- application/ -> puertos (application/) ---
Rel(uc_request_transfer, port_repo, "persiste transacción", "llamada interna | síncrono")
Rel(uc_request_transfer, port_publisher, "publica customer.kyc.check.requested", "llamada interna | síncrono")
Rel(uc_get_status, port_repo, "lee transacción", "llamada interna | síncrono")
Rel(uc_get_status, port_publisher, "publica transaction.status.replied", "llamada interna | síncrono")
Rel(uc_list_tx, port_repo, "consulta con filtros", "llamada interna | síncrono")
Rel(uc_list_tx, port_publisher, "publica transaction.list.replied", "llamada interna | síncrono")
Rel(uc_get_stats, port_repo, "agrega métricas", "llamada interna | síncrono")
Rel(uc_get_stats, port_publisher, "publica transaction.stats.replied", "llamada interna | síncrono")
Rel(uc_record_attempt, port_repo, "persiste intento fallido", "llamada interna | síncrono")
Rel(saga, port_repo, "persiste transición", "llamada interna | síncrono")
Rel(saga, port_publisher, "publica account.debit.requested, payment.requested, account.credit.requested, account.debit.compensation.requested, transaction.completed, transaction.failed, transaction.compensated", "llamada interna | síncrono")

' --- infrastructure/ implementa puertos de application/ (dependencia hacia adentro) ---
Rel(repo_impl, port_repo, "implementa", "interfaz")
Rel(pub_adapter, port_publisher, "implementa", "interfaz")

' --- infrastructure/ <-> broker y base de datos ---
Rel(repo_impl, transaction_db, "lee/escribe tabla transactions y outbox", "TCP/IP | acceso a datos")
Rel(pub_adapter, amqp, "usa conexión", "llamada interna")
Rel(sub_adapter, amqp, "usa conexión", "llamada interna")
Rel(outbox_relay, repo_impl, "lee mensajes pendientes", "llamada interna")
Rel(outbox_relay, amqp, "publica periódicamente a RabbitMQ", "llamada interna")
Rel(amqp, rabbitmq, "conexión AMQP, ack manual, DLQ", "AMQP | conexión")
Rel(pub_adapter, rabbitmq, "publica comandos/eventos", "AMQP | comandos/eventos | correlationId")
Rel(rabbitmq, sub_adapter, "entrega comandos/eventos", "AMQP | comandos/eventos | correlationId")

' --- infrastructure/ -> interfaces/ (enrutamiento de deliveries) ---
Rel(sub_adapter, h_transfer, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_status, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_list, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_stats, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_kyc_checked, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_debited, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_debit_rejected, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_paid, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_pay_failed, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_attempt_failed, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_credited, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_credit_rejected, "enruta por messageType", "llamada interna | síncrono")
Rel(sub_adapter, h_compensated, "enruta por messageType", "llamada interna | síncrono")

SHOW_LEGEND()
@enduml
