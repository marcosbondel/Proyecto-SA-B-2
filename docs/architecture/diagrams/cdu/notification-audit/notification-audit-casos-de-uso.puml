@startuml notification-audit-casos-de-uso
left to right direction

title CDU005 - Gestionar notificaciones y auditoría

skinparam shadowing false
skinparam dpi 180
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #1168BD
    FontColor #1168BD
}
skinparam actor {
    BorderColor #398819
    FontColor #398819
}

actor "Administrador" as actor_notification_admin
actor "Customer Service" as actor_notification_customer
actor "Account Service" as actor_notification_account
actor "Transaction Service" as actor_notification_transaction
actor "Payment Service" as actor_notification_payment
actor "Servicio de correo" as actor_notification_email

rectangle "CDU005 - Gestionar notificaciones y auditoría" as system_notification {
    usecase "CDU005.1:\nRegistrar evento de auditoría" as uc_notification_audit
    usecase "CDU005.2:\nEnviar notificación" as uc_notification_notify
    usecase "CDU005.3:\nConsultar auditoría" as uc_notification_query_audit
    usecase "CDU005.4:\nConsultar notificaciones" as uc_notification_query_notifications
    usecase "CDU005.5:\nPersistir evento inmutable" as uc_notification_persist
    usecase "CDU005.6:\nRegistrar estado de entrega" as uc_notification_delivery
    usecase "CDU005.7:\nFiltrar por correlationId" as uc_notification_filter
}

actor_notification_admin -- uc_notification_query_audit
actor_notification_admin -- uc_notification_query_notifications
actor_notification_customer -- uc_notification_audit
actor_notification_account -- uc_notification_audit
actor_notification_transaction -- uc_notification_audit
actor_notification_payment -- uc_notification_audit
actor_notification_email -- uc_notification_notify

uc_notification_audit .> uc_notification_persist : <<include>>
uc_notification_notify .> uc_notification_delivery : <<include>>
uc_notification_query_audit .> uc_notification_filter : <<include>>

note right of system_notification
    Es un servicio terminal: consume eventos,
    registra auditoría y produce efectos de notificación.
    No publica eventos que decidan lógica de negocio.
end note
legend bottom
  Implementación: Node.js 24 / NestJS / TypeScript.
  Mensajes internos: RabbitMQ / AMQP 0-9-1; correlationId y traceparent.
  Persistencia: PostgreSQL exclusivo por servicio. Entrada: Gateway HTTP / JWT / roles.
  Vistas complementarias de Fase III: diagrama 13 e índice de arquitectura.
endlegend
@enduml
