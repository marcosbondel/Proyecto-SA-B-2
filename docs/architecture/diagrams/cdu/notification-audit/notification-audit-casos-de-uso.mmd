flowchart LR
    admin["👤 Administrador"]
    customerService["⚙ Customer Service"]
    accountService["⚙ Account Service"]
    transactionService["⚙ Transaction Service"]
    paymentService["⚙ Payment Service"]
    email["✉ Servicio de correo"]

    subgraph notification["CDU005 · Gestionar notificaciones y auditoría"]
        audit(("CDU005.1: Registrar evento de auditoría"))
        notify(("CDU005.2: Enviar notificación"))
        queryAudit(("CDU005.3: Consultar auditoría"))
        queryNotifications(("CDU005.4: Consultar notificaciones"))
        persist(("CDU005.5: Persistir evento inmutable"))
        delivery(("CDU005.6: Registrar estado de entrega"))
        filterAudit(("CDU005.7: Filtrar por correlationId"))
    end

    admin --- queryAudit
    admin --- queryNotifications
    customerService --- audit
    accountService --- audit
    transactionService --- audit
    paymentService --- audit
    email --- notify

    audit -. "«include»" .-> persist
    notify -. "«include»" .-> delivery
queryAudit -. "«include»" .-> filterAudit

    note["Notification & Audit es terminal; no publica eventos de decisión"]:::note
    audit -.-> note

    classDef note fill:#FFF8DC,stroke:#D6B656,color:#555555;
