@startuml notification-audit-flujos
title Flujo funcional - Notification & Audit Service

skinparam shadowing false
skinparam activity {
    BackgroundColor #F4F8FF
    BorderColor #1168BD
    FontColor #1168BD
}

start
:Consumir un evento de bank.events;
:Validar correlationId y deduplicar por eventId;
if (¿Evento repetido o inválido?) then (Sí)
    :Descartar o enviar a la política de errores;
else (No)
    :Persistir AuditEvent inmutable;
    if (¿Requiere notificación?) then (Sí)
        :Crear Notification PENDING;
        :Enviar por el canal configurado;
        if (¿Entrega exitosa?) then (Sí)
            :Registrar SENT;
        else (No)
            :Registrar FAILED y reintentar;
        endif
    else (No)
        :Finalizar consumo del evento;
    endif
endif
stop
@enduml
