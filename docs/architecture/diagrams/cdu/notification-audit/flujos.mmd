flowchart TD
    event(["Consumir evento de bank.events"])
    validate["Validar correlationId y deduplicar por eventId"]
    invalid{"¿Repetido o inválido?"}
    discard["Descartar o enviar a errores"]
    persist["Persistir AuditEvent inmutable"]
    notifyDecision{"¿Requiere notificación?"}
    pending["Crear Notification PENDING"]
    send["Enviar por canal configurado"]
    sent["Registrar SENT"]
    retry["Registrar FAILED y reintentar"]
    done["Finalizar consumo"]

    event --> validate --> invalid
    invalid -->|"Sí"| discard
    invalid -->|"No"| persist --> notifyDecision
    notifyDecision -->|"Sí"| pending --> send
    notifyDecision -->|"No"| done
    send -->|"Éxito"| sent --> done
    send -->|"Fallo"| retry
