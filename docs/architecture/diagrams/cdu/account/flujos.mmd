flowchart TD
    start(["Inicio: Account Service recibe comando o evento"]) --> operation{"¿Qué operación?"}

    subgraph open["Abrir cuenta"]
        o1["Validar customerId, rol CLIENTE y accountType"] --> o2{"¿Elegible?"}
        o2 -->|"Sí"| o3["Crear ACTIVE con balance 0.00"]
        o3 --> o4["Publicar account.opened"]
        o2 -->|"No"| o5["Rechazar creación"]
    end

    subgraph balance["Consultar saldo"]
        b1["Validar autorización"] --> b2{"¿Acceso permitido?"}
        b2 -->|"Sí"| b3["Responder balance por request/reply"]
        b2 -->|"No"| b4["Responder FORBIDDEN_ACCOUNT_ACCESS"]
    end

    subgraph movement["Movimiento de Saga"]
        m1["Identificar débito, crédito o compensación"] --> m2["Validar estado y balance"]
        m2 --> m3{"¿Débito con fondos?"}
        m3 -->|"Sí"| m4["Aplicar atómicamente y actualizar actividad"]
        m4 --> m5["Publicar evento de movimiento"]
        m3 -->|"No"| m6["Publicar account.debit.rejected"]
    end

    subgraph status["Estado de cuenta"]
        s1{"¿Cambio manual?"}
        s1 -->|"Sí"| s2["Administrador aplica account.set-status"]
        s1 -->|"No"| s3["Evaluar seis meses y balance menor que Q50.00"]
        s3 --> s4["Desactivar cuentas elegibles"]
        s2 --> s5["Publicar account.deactivated o account.reactivated"]
        s4 --> s5
    end

    operation -->|"Abrir"| o1
    operation -->|"Saldo"| b1
    operation -->|"Saga"| m1
    operation -->|"Estado"| s1
