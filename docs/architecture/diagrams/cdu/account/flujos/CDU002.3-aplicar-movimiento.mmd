flowchart TD
    transaction["Transaction Service: solicitar movimiento"] --> identify["Account Service: identificar débito, crédito o compensación"]
    identify --> state["Validar estado de la cuenta"]
    state --> type{"¿Tipo de movimiento?"}
    type -->|Débito| funds["Validar fondos suficientes"]
    funds --> available{"¿Fondos disponibles?"}
    available -->|No| rejected["Publicar account.debit.rejected"]
    available -->|Sí| debit["Aplicar débito"]
    type -->|Crédito| credit["Aplicar crédito"]
    type -->|Compensación| compensate["Devolver débito aplicado"]
    debit --> event["Actualizar actividad y publicar evento"]
    credit --> event
    compensate --> event
