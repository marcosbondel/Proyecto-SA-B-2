flowchart TD
    start{"¿Cambio solicitado por Administrador?"}
    start -->|Sí| manual["Administrador: solicitar cambio"]
    start -->|No| automatic["Proceso automático: evaluar inactividad y balance"]
    manual --> validate["Account Service: validar transición"]
    automatic --> validate
    validate --> decision{"¿Transición válida?"}
    decision -->|No| reject["Rechazar cambio"]
    decision -->|Sí| persist["Persistir nuevo estado"]
    persist --> publish["Publicar account.deactivated o account.reactivated"]
