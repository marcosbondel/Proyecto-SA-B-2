@startuml account-flujos
title Flujos funcionales - Account Service

skinparam shadowing false
skinparam activity {
    BackgroundColor #F4F8FF
    BorderColor #1168BD
    FontColor #1168BD
}

start
:Recibir comando o evento;

if (¿Qué operación?) then (Abrir cuenta)
    :Validar customerId, rol CLIENTE y accountType;
    if (¿Elegible?) then (Sí)
        :Crear cuenta ACTIVE con balance 0.00;
        :Publicar account.opened;
    else (No)
        :Rechazar ROLE_NOT_ELIGIBLE o CUSTOMER_NOT_FOUND;
    endif
elseif (Consultar saldo)
    :Validar autorización sobre la cuenta;
    if (¿Acceso permitido?) then (Sí)
        :Responder balance por request/reply asíncrono;
    else (No)
        :Responder FORBIDDEN_ACCOUNT_ACCESS;
    endif
elseif (Movimiento de Saga)
    :Identificar débito, crédito o compensación;
    :Validar estado y reglas de balance;
    if (¿Débito con fondos suficientes?) then (Sí)
        :Aplicar movimiento atómicamente;
        :Actualizar lastActivityAt;
        :Publicar evento de movimiento;
    else (No)
        :Publicar account.debit.rejected;
    endif
else (Estado automático o manual)
    if (¿Administrador solicita cambio?) then (Sí)
        :Aplicar account.set-status;
    else (Proceso automático)
        :Evaluar seis meses de inactividad y balance menor que Q50.00;
        :Desactivar cuentas que cumplan ambas condiciones;
    endif
    :Publicar account.deactivated o account.reactivated;
endif

stop
@enduml
