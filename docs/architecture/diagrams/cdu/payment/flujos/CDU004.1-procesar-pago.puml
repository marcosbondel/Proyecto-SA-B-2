@startuml CDU004.1-procesar-pago
title CDU004.1 - Procesar pago

skinparam shadowing false
skinparam activity {
    BackgroundColor #F4F8FF
    BorderColor #1168BD
    FontColor #1168BD
}

|Transaction Service|
start
:Publicar comando payment.requested (en sobre AMQP);
|Payment Service|
:Validar operación y registrar en estado PENDING;
:Ejecutar intento con proveedor externo simulado;
while (¿Resultado TIMEOUT o fallo transitorio?) is (Sí)
    if (¿Quedan reintentos en la escalera?) then (Sí)
        :Registrar intento fallido;
        :Publicar payment.attempt.failed (evento observable);
        :Calcular fecha/hora de siguiente intento (next_attempt_at);
        :Esperar vencimiento programado (barrido del scheduler);
        :Ejecutar nuevo intento de pago;
    else (No)
        break
    endif
endwhile (No)

if (¿Autorización exitosa?) then (Sí)
    :Registrar estado SUCCEEDED en base de datos;
    :Publicar evento payment.succeeded;
else (No)
    :Registrar estado FAILED con failureReason;
    :Publicar evento terminal payment.failed;
endif
|Transaction Service|
:Continuar la Saga según resultado (crédito o compensación);
stop
@enduml
