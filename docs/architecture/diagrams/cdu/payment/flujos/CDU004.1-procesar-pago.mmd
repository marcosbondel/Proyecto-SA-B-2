flowchart TD
    transaction["Transaction Service: solicitar payment.requested"] --> validate["Payment Service: validar y registrar PENDING"]
    validate --> type{"¿Pago interno?"}
    type -->|Sí| internal["Procesar pago interno"]
    type -->|No| external["Solicitar pago al proveedor externo"]
    internal --> result{"¿Procesamiento exitoso?"}
    external --> result
    result -->|Sí| success["Registrar SUCCEEDED y publicar payment.succeeded"]
    result -->|No| retry["Reintentar procesamiento"]
    retry --> attempts{"¿Quedan reintentos?"}
    attempts -->|Sí| result
    attempts -->|No| failed["Registrar FAILED y publicar payment.failed"]
