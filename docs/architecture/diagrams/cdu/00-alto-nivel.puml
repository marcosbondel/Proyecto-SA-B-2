@startuml 00-alto-nivel
left to right direction

title CDU000 - Bank USAC: alto nivel

skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #FFF8EE
    BorderColor #EF9425
    FontColor #8A4B00
}
skinparam actor {
    BorderColor #398819
    FontColor #398819
}

' Actores primarios (iniciadores humanos del negocio)
actor "Visitante / Cliente" as cliente
actor "Cajero Receptor" as cajero
actor "Administrador" as admin

rectangle "Bank USAC\nSistema bancario" as bank {
    usecase "CDU000:\nGestionar operaciones bancarias" as core
}

' Actores secundarios (sistemas externos de soporte)
actor "Proveedor de Pagos" as proveedorPagos
actor "Servicio de Correo" as correo

cliente -- core
cajero -- core
admin -- core

core -- proveedorPagos
core -- correo

note right of core
    Núcleo funcional del sistema.
    La primera vista funcional se muestra
    en CDU001 a CDU005.
end note

legend right
    |= Elemento |= Significado |
    | Actor (Izquierda) | Actor primario: rol humano que inicia operaciones |
    | Actor (Derecha) | Actor secundario: sistema externo de apoyo/notificación |
    | Caso de uso | Objetivo observable en el nivel de negocio |
    | Rectángulo | Límite del sistema Bank USAC |
endlegend
@enduml
