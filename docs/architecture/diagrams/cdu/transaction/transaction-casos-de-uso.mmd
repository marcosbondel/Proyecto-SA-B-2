flowchart LR
    client["👤 Cliente"]
    teller["👤 Cajero Receptor"]
    admin["👤 Administrador"]
    accountService["⚙ Account Service"]
    paymentService["⚙ Payment Service"]

    subgraph transaction["CDU003 · Gestionar transferencias"]
        transfer(("CDU003.1: Transferir fondos"))
        status(("CDU003.2: Consultar estado de transferencia"))
        validate(("CDU003.3: Validar solicitud de transferencia"))
        saga(("CDU003.4: Coordinar Saga de transferencia"))
        requestFunds(("CDU003.5: Solicitar validación de fondos"))
        requestPayment(("CDU003.6: Solicitar pago"))
        requestCredit(("CDU003.7: Ordenar crédito"))
        compensate(("CDU003.8: Compensar débito"))
        record(("CDU003.9: Registrar estado de transacción"))
    end

    client --- transfer
    client --- status
    teller --- transfer
    teller --- status
    admin --- transfer
    admin --- status
    accountService --- saga
    paymentService --- saga

    transfer -. "«include»" .-> validate
    transfer -. "«include»" .-> saga
    transfer -. "«include»" .-> record
    saga -. "«include»" .-> requestFunds
    saga -. "«include»" .-> requestPayment
    saga -. "«include»" .-> requestCredit
    compensate -. "«extend»" .-> saga

    note["Transaction valida la solicitud y conserva el estado; Account valida los fondos"]:::note
    validate -.-> note

    classDef note fill:#FFF8DC,stroke:#D6B656,color:#555555;
