flowchart TD
    actor["Cliente, Cajero o Administrador: escribir la actual y la nueva"] --> gateway["Gateway: publicar customer.change-password"]
    gateway --> own{"¿Es la contraseña del propio solicitante?"}
    own -->|No| forbidden["Rechazar FORBIDDEN_ACCOUNT_ACCESS"]
    own -->|Sí| verify["Customer Service: verificar la actual con el mismo hasher"]
    verify --> matches{"¿Coincide?"}
    matches -->|No| invalid["Rechazar INVALID_CREDENTIALS"]
    matches -->|Sí| save["Guardar el nuevo hash con el registro de idempotencia"]
    save --> publish["Publicar customer.password-changed"]
    publish --> audit["Notification & Audit: registrar el cambio"]
