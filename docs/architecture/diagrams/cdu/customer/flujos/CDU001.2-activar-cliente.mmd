flowchart TD
    client["Cliente: abrir enlace"] --> gateway["Gateway: publicar customer.verify-email"]
    gateway --> validate["Customer Service: validar token"]
    validate --> decision{"¿Token válido y vigente?"}
    decision -->|No| reject["Rechazar ACTIVATION_TOKEN_INVALID"]
    decision -->|Sí| active["Marcar email verificado y estado ACTIVE"]
