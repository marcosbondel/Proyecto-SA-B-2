flowchart TD
    start(["Inicio: operación de Customer Service"])
    decision{"¿Qué operación?"}
    start --> decision

    subgraph register["Registrar cliente"]
        r1["Publicar customer.register"] --> r2["Validar unicidad y coherencia"]
        r2 --> r3{"¿Datos válidos?"}
        r3 -->|"Sí"| r4["Generar username y persistir PENDING_ACTIVATION"]
        r4 --> r5["Publicar customer.registered"]
        r3 -->|"No"| r6["Responder error de registro"]
    end

    subgraph activate["Activar cuenta por correo"]
        a1["Publicar customer.verify-email"] --> a2["Validar token"]
        a2 --> a3{"¿Token válido?"}
        a3 -->|"Sí"| a4["Marcar ACTIVE y publicar customer.email.verified"]
        a3 -->|"No"| a5["Publicar rechazo de verificación"]
    end

    subgraph login["Iniciar sesión"]
        l1["Publicar customer.authenticate"] --> l2["Validar credenciales"]
        l2 --> l3{"¿Credenciales válidas?"}
        l3 -->|"No"| l4["Rechazar INVALID_CREDENTIALS"]
        l3 -->|"Sí"| l5{"¿Correo verificado?"}
        l5 -->|"Sí"| l6["Responder claims y publicar login.succeeded"]
        l5 -->|"No"| l7["Solicitar activación y rechazar acceso"]
    end

    subgraph update["Actualizar datos"]
        u1["Publicar customer.update"] --> u2["Validar, persistir y publicar customer.updated"]
    end

    subgraph identity["Validar identidad"]
        i1["Recibir foto y datos"] --> i2["Revisar identidad"]
        i2 --> i3{"¿Identidad válida?"}
        i3 -->|"Sí"| i4["Persistir VALIDATED y publicar evento"]
        i3 -->|"No"| i5["Persistir REJECTED y publicar evento"]
    end

    decision -->|"Registrar"| r1
    decision -->|"Activar"| a1
    decision -->|"Iniciar sesión"| l1
    decision -->|"Actualizar"| u1
    decision -->|"Validar identidad"| i1

    classDef decision fill:#FFF8DC,stroke:#D6B656,color:#555555;
