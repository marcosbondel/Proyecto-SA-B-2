flowchart LR
    client["👤 Visitante / Cliente"]
    teller["👤 Cajero Receptor"]
    admin["👤 Administrador"]

    subgraph customer["CDU001 · Gestionar clientes e identidad"]
        register(("CDU001.1: Registrar cliente"))
        activate(("CDU001.2: Activar cliente por correo"))
        login(("CDU001.3: Iniciar sesión"))
        update(("CDU001.4: Actualizar datos del cliente"))
        upload(("CDU001.5: Cargar fotografía de identidad"))
        identity(("CDU001.6: Validar identidad"))
        username(("CDU001.7: Generar username único"))
        token(("CDU001.8: Validar token de activación"))
        credentials(("CDU001.9: Validar credenciales"))
        review(("CDU001.10: Revisar foto y datos"))
    end

    client --- register
    client --- activate
    client --- login
    client --- update
    client --- upload
    teller --- register
    teller --- login
    teller --- update
    teller --- identity
    admin --- register
    admin --- login
    admin --- update
    admin --- identity

    register -. "«include»" .-> username
    activate -. "«include»" .-> token
    login -. "«include»" .-> credentials
    identity -. "«include»" .-> review

    note["La activación por correo y la validación de identidad son flujos independientes"]:::note
    activate -.-> note

    classDef note fill:#FFF8DC,stroke:#D6B656,color:#555555;
