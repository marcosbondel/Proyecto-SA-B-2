@startuml customer-flujos
title Flujos funcionales - Customer Service

skinparam shadowing false
skinparam activity {
    BackgroundColor #F4F8FF
    BorderColor #1168BD
    FontColor #1168BD
}

start
:El actor solicita una operación de Customer Service;

if (¿Qué operación?) then (Registrar)
    :Gateway publica customer.register;
    :Validar unicidad y coherencia de datos;
    if (¿Datos válidos?) then (Sí)
        :Generar username único;
        :Persistir Customer como PENDING_ACTIVATION;
        :Publicar customer.registered;
    else (No)
        :Responder el error de registro;
    endif
elseif (Activar)
    :Gateway publica customer.verify-email;
    :Validar token de activación;
    if (¿Token válido?) then (Sí)
        :Marcar email como verificado;
        :Cambiar Customer a ACTIVE;
        :Publicar customer.email.verified;
    else (No)
        :Publicar rechazo de verificación;
    endif
elseif (Iniciar sesión)
    :Gateway publica customer.authenticate;
    :Validar credenciales;
    if (¿Credenciales válidas?) then (Sí)
        if (¿Correo verificado?) then (Sí)
            :Responder claims al Gateway;
            :Publicar customer.login.succeeded;
        else (No)
            :Publicar customer.activation.requested;
            :Rechazar con ACCOUNT_PENDING_ACTIVATION;
        endif
    else (No)
        :Rechazar con INVALID_CREDENTIALS;
    endif
elseif (Actualizar datos)
    :Gateway publica customer.update;
    :Validar y persistir cambios permitidos;
    :Publicar customer.updated;
else (Validar identidad)
    :Recibir customer.validate-identity;
    :Leer referencia de la foto;
    :Verificar integridad y revisar identidad;
    if (¿Identidad válida?) then (Sí)
        :Persistir VALIDATED;
        :Publicar customer.identity.validated;
    else (No)
        :Persistir REJECTED;
        :Publicar customer.identity.rejected;
    endif
endif

stop
@enduml
