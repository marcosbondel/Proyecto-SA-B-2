%% UML 2 Deployment Diagram - Bank USAC
%% Mermaid has no native UML 2 Deployment notation; this flowchart uses
%% nested boundaries and UML/Kubernetes labels to keep the same model.
flowchart TB

    subgraph host["Developer Host · «device»"]
        direction TB

        subgraph docker["Docker Engine · «executionEnvironment»"]
            direction TB
            rabbitmq["RabbitMQ<br/>«node»<br/>RabbitMQ 4.3.4-management"]:::external
            rabbit_image["rabbitmq:4.3.4-management<br/>«artifact»"]:::artifact

            customer_db["Customer DB<br/>«node»<br/>PostgreSQL 18.4"]:::external
            customer_db_image["postgres:18.4<br/>«artifact»"]:::artifact
            account_db["Account DB<br/>«node»<br/>PostgreSQL 18.4"]:::external
            account_db_image["postgres:18.4<br/>«artifact»"]:::artifact
            transaction_db["Transaction DB<br/>«node»<br/>PostgreSQL 18.4"]:::external
            transaction_db_image["postgres:18.4<br/>«artifact»"]:::artifact
            payment_db["Payment DB<br/>«node»<br/>PostgreSQL 18.4"]:::external
            payment_db_image["postgres:18.4<br/>«artifact»"]:::artifact
            notification_db["Notification DB<br/>«node»<br/>PostgreSQL 18.4"]:::external
            notification_db_image["postgres:18.4<br/>«artifact»"]:::artifact

            deployment_properties["<b>Deployment properties · «note»</b><br/>RabbitMQ: container rabbitmq · AMQP 5672 · management 15672<br/>Customer DB: customer-db · bankusac_customer · customer_user · host mapping 5433<br/>Account DB: account-db · bankusac_account · account_user · host mapping 5434<br/>Transaction DB: transaction-db · bankusac_transaction · transaction_user · host mapping 5435<br/>Payment DB: payment-db · bankusac_payment · payment_user · host mapping 5436<br/>Notification DB: notification-db · bankusac_notification · notification_user · host mapping 5437"]:::note

            rabbit_image -. "runs as" .-> rabbitmq
            customer_db_image -. "runs as" .-> customer_db
            account_db_image -. "runs as" .-> account_db
            transaction_db_image -. "runs as" .-> transaction_db
            payment_db_image -. "runs as" .-> payment_db
            notification_db_image -. "runs as" .-> notification_db
        end

        subgraph kind["kind cluster · «node» · single-node local limitation"]
            direction TB
            subgraph worker["kind-worker · «device»"]
                direction TB
                subgraph namespace["Namespace bank-usac · «executionEnvironment»"]
                    direction TB
                    namespace_resource["Namespace resource<br/>«executionEnvironment»"]:::runtime

                    subgraph dep_frontend["Deployment/frontend · «deployment» · replicas=1"]
                        direction TB
                        pod_frontend["Pod/frontend · «executionEnvironment»"]:::pod
                        image_frontend["«artifact»<br/>bank-usac/frontend:&lt;git-sha&gt;<br/>Nuxt 4"]:::artifact
                        image_frontend -. "«deploy»" .-> pod_frontend
                    end
                    subgraph dep_gateway["Deployment/gateway · «deployment» · replicas=1"]
                        direction TB
                        pod_gateway["Pod/gateway · «executionEnvironment»"]:::pod
                        image_gateway["«artifact»<br/>bank-usac/gateway:&lt;git-sha&gt;<br/>NestJS"]:::artifact
                        image_gateway -. "«deploy»" .-> pod_gateway
                    end
                    subgraph dep_customer["Deployment/customer · «deployment» · replicas=1"]
                        direction TB
                        pod_customer["Pod/customer · «executionEnvironment»"]:::pod
                        image_customer["«artifact»<br/>bank-usac/customer:&lt;git-sha&gt;<br/>NestJS"]:::artifact
                        image_customer -. "«deploy»" .-> pod_customer
                    end
                    subgraph dep_account["Deployment/account · «deployment» · replicas=1"]
                        direction TB
                        pod_account["Pod/account · «executionEnvironment»"]:::pod
                        image_account["«artifact»<br/>bank-usac/account:&lt;git-sha&gt;<br/>NestJS"]:::artifact
                        image_account -. "«deploy»" .-> pod_account
                    end
                    subgraph dep_transaction["Deployment/transaction · «deployment» · replicas=1"]
                        direction TB
                        pod_transaction["Pod/transaction · «executionEnvironment»"]:::pod
                        image_transaction["«artifact»<br/>bank-usac/transaction:&lt;git-sha&gt;<br/>NestJS"]:::artifact
                        image_transaction -. "«deploy»" .-> pod_transaction
                    end
                    subgraph dep_payment["Deployment/payment · «deployment» · replicas=1"]
                        direction TB
                        pod_payment["Pod/payment · «executionEnvironment»"]:::pod
                        image_payment["«artifact»<br/>bank-usac/payment:&lt;git-sha&gt;<br/>NestJS"]:::artifact
                        image_payment -. "«deploy»" .-> pod_payment
                    end
                    subgraph dep_notification["Deployment/notification-audit · «deployment» · replicas=1"]
                        direction TB
                        pod_notification["Pod/notification-audit · «executionEnvironment»"]:::pod
                        image_notification["«artifact»<br/>bank-usac/notification:&lt;git-sha&gt;<br/>NestJS"]:::artifact
                        image_notification -. "«deploy»" .-> pod_notification
                    end

                    svc_frontend["Service/frontend<br/>«service»"]:::service
                    svc_gateway["Service/gateway<br/>«service»"]:::service
                    svc_customer["Service/customer<br/>«service»"]:::service
                    svc_account["Service/account<br/>«service»"]:::service
                    svc_transaction["Service/transaction<br/>«service»"]:::service
                    svc_payment["Service/payment<br/>«service»"]:::service
                    svc_notification["Service/notification-audit<br/>«service»"]:::service

                    configmap["ConfigMap/bank-usac-config<br/>«artifact»"]:::config
                    secret["Secret/bank-usac-secrets<br/>«artifact»"]:::secret
                    kubernetes_properties["<b>Kubernetes properties · «note»</b><br/>Frontend/Gateway: exposed with kubectl port-forward<br/>Other Services: ClusterIP<br/>ConfigMap: non-sensitive runtime configuration<br/>Secret: JWT, database and RabbitMQ credentials<br/>Secret values are not versioned<br/>Dashed ConfigMap/Secret links reference the Pod specifications at runtime"]:::note

                    svc_frontend -->|selects / forwards| pod_frontend
                    svc_gateway -->|selects / forwards| pod_gateway
                    svc_customer -->|selects / forwards| pod_customer
                    svc_account -->|selects / forwards| pod_account
                    svc_transaction -->|selects / forwards| pod_transaction
                    svc_payment -->|selects / forwards| pod_payment
                    svc_notification -->|selects / forwards| pod_notification
                end
            end
        end

        portforward["kubectl port-forward<br/>«executionEnvironment»"]:::runtime
        helm_chart["Helm chart<br/>«artifact»<br/>infra/k8s/helm/bank-usac"]:::artifact
    end

    helm_chart -. "«deploy» helm upgrade --install" .-> namespace_resource

    configmap -.-> pod_frontend
    configmap -.-> pod_gateway
    configmap -.-> pod_customer
    configmap -.-> pod_account
    configmap -.-> pod_transaction
    configmap -.-> pod_payment
    configmap -.-> pod_notification
    secret -.-> pod_gateway
    secret -.-> pod_customer
    secret -.-> pod_account
    secret -.-> pod_transaction
    secret -.-> pod_payment
    secret -.-> pod_notification

    portforward -->|HTTP · localhost:3000| svc_frontend
    portforward -->|HTTP · localhost:3001| svc_gateway

    pod_gateway <-->|AMQP/TCP 5672<br/>host.docker.internal| rabbitmq
    pod_customer <-->|AMQP/TCP 5672<br/>host.docker.internal| rabbitmq
    pod_account <-->|AMQP/TCP 5672<br/>host.docker.internal| rabbitmq
    pod_transaction <-->|AMQP/TCP 5672<br/>host.docker.internal| rabbitmq
    pod_payment <-->|AMQP/TCP 5672<br/>host.docker.internal| rabbitmq
    pod_notification <-->|AMQP/TCP 5672<br/>host.docker.internal| rabbitmq

    pod_customer -->|PostgreSQL/TCP<br/>host.docker.internal| customer_db
    pod_account -->|PostgreSQL/TCP<br/>host.docker.internal| account_db
    pod_transaction -->|PostgreSQL/TCP<br/>host.docker.internal| transaction_db
    pod_payment -->|PostgreSQL/TCP<br/>host.docker.internal| payment_db
    pod_notification -->|PostgreSQL/TCP<br/>host.docker.internal| notification_db

    subgraph legend["Notas de modelado"]
        direction LR
        uml_node["«device» / «node»<br/>recurso de cómputo"]:::external
        uml_environment["«executionEnvironment»<br/>entorno de ejecución"]:::runtime
        uml_artifact["«artifact»<br/>imagen o configuración"]:::artifact
        uml_path["asociación sólida<br/>communication path"]:::service
        uml_deploy["dependencia discontinua<br/>«deploy» / referencia de configuración"]:::artifact
    end

    classDef external fill:#FFF0F0,stroke:#C11926,color:#C11926,stroke-width:1.5px;
    classDef runtime fill:#EAF2FF,stroke:#1168BD,color:#1168BD,stroke-width:1.5px;
    classDef pod fill:#FFF8EE,stroke:#EF9425,color:#EF9425,stroke-width:1.5px;
    classDef service fill:#FFFFFF,stroke:#1168BD,color:#1168BD,stroke-width:1.5px;
    classDef artifact fill:#FFFFFF,stroke:#398819,color:#398819,stroke-width:1.5px;
    classDef config fill:#F2FAEF,stroke:#398819,color:#398819,stroke-width:1.5px;
    classDef secret fill:#FFF0F0,stroke:#C11926,color:#C11926,stroke-width:1.5px;
    classDef note fill:#FFF8DC,stroke:#D6B656,color:#555555,stroke-width:1.2px,stroke-dasharray: 4 3;
