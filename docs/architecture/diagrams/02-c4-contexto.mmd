%% Bank USAC - C4 Nivel 1 - Diagrama de Contexto
%% El API Gateway aparece explicitamente dentro del limite del sistema porque el
%% enunciado lo exige en este nivel y evalua la "Representacion correcta del
%% Gateway como punto de entrada". Cada relacion declara tecnologia, protocolo y
%% tipo de interaccion (sincrona o asincrona).
%% Debe coincidir con 02-c4-contexto.puml en TODAS las etiquetas.

C4Context
    title Bank USAC — Diagrama de Contexto (C4 Nivel 1)
    UpdateLayoutConfig($c4ShapeInRow="1", $c4BoundaryInRow="1")

    Person(cliente, "Cliente [CLIENTE]", "Cuentahabiente. Opera sobre<br>sus propias cuentas: consulta<br>saldo, transfiere y gestiona datos.")
    Person(cajero, "Cajero Receptor <br>[CAJERO_RECEPTOR]", "Personal en ventanilla.<br>Registra clientes, abre cuentas<br>y transfiere por el cliente presente.")
    Person(admin, "Administrador <br>[ADMINISTRADOR]", "Supervisa: gestiona roles,<br>activa/desactiva cuentas y<br>consulta la auditoría.")

    System_Boundary(limite, "Bank USAC") {
        System(gateway, "API Gateway", "Único punto de entrada. Autentica con JWT,<br>autoriza por rol y traduce cada petición HTTP<br>en un mensaje. No contiene lógica de negocio<br>ni orquesta la Saga.")
        System(bankusac, "Núcleo Bancario Bank USAC", "Sistema bancario distribuido. Gestiona clientes,<br>cuentas, transferencias, pagos y auditoría.<br>No es accesible desde fuera: solo responde<br>a mensajes.")
    }

    System_Ext(correo, "Servicio de Correo Electrónico", "Entrega al cliente el enlace<br>de activación de cuenta.")
    System_Ext(proveedorPagos, "Proveedor de Pagos", "Procesa pagos externos que<br>el banco no resuelve internamente.")

    Rel(cliente, gateway, "Consulta y gestiona sus cuentas", "HTTPS/REST · síncrono")
    Rel(cajero, gateway, "Atiende clientes en ventanilla", "HTTPS/REST · síncrono")
    Rel(admin, gateway, "Supervisa cuentas y auditoría", "HTTPS/REST · síncrono")

    Rel(gateway, bankusac, "Publica comandos y consultas con correlationId", "AMQP 0-9-1 · asíncrono")
    Rel(bankusac, gateway, "Responde por cola de respuesta", "AMQP 0-9-1 · request/reply")

    Rel(bankusac, correo, "Solicita el correo de activación", "SMTP · asíncrono")
    Rel(correo, cliente, "Entrega el enlace de activación", "Correo electrónico · asíncrono")
    Rel(bankusac, proveedorPagos, "Solicita la autorización del pago", "API del proveedor · síncrono")

    UpdateRelStyle(cliente, gateway, $offsetX="140", $offsetY="-150")
    UpdateRelStyle(cajero, gateway, $offsetX="140", $offsetY="-10")
    UpdateRelStyle(admin, gateway, $offsetX="140", $offsetY="130")
    UpdateRelStyle(correo, cliente, $offsetX="-170", $offsetY="0")
    UpdateRelStyle(bankusac, correo, $offsetX="-185", $offsetY="-60")
    UpdateRelStyle(bankusac, proveedorPagos, $offsetX="-200", $offsetY="-45")
    UpdateRelStyle(gateway, bankusac, $offsetX="-195", $offsetY="-12")
    UpdateRelStyle(bankusac, gateway, $offsetX="85", $offsetY="30")
