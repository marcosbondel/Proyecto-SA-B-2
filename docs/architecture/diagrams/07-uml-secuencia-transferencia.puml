@startuml 07-uml-secuencia-transferencia
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 14
skinparam dpi 180
skinparam maxMessageSize 190
skinparam ParticipantBorderColor #1168BD
skinparam ParticipantBackgroundColor #EAF2FF
skinparam QueueBorderColor #C11926
skinparam QueueBackgroundColor #FFF0F0
skinparam noteBackgroundColor #FFF8DC
skinparam noteBorderColor #D6B656
autonumber
title UML - Transferencia interna / Saga - Fase III\nKYC -> débito -> pago -> crédito o compensación
actor "Cliente / Cajero autorizado" as U
participant "Frontend\nNuxt 4 / Nitro" as W
participant "Gateway\nNestJS / HTTP" as G
queue "RabbitMQ\nAMQP 0-9-1" as B
participant "Transaction\nNestJS / PostgreSQL" as T
participant "Customer\nNestJS / PostgreSQL" as C
participant "Account\nNestJS / PostgreSQL" as A
participant "Payment\nNestJS / PostgreSQL" as P
participant "Notification & Audit" as N
participant "Collector -> Tempo" as O
U -> W : Solicitar transferencia
W -> G : POST /api/transfers\nJWT + Idempotency-Key
G ->> B : transfer.requested.v1\ncorrelationId + traceparent
G --> W : 202 / transactionId + interbankTransferId + correlationId\nCabecera X-Trace-Id
B ->> T : Crear PENDING / deduplicar / outbox
T ->> B : customer.kyc.check.requested.v1
B ->> C : Comprobar identidad KYC
C ->> B : customer.kyc.checked.v1
B ->> T : Veredicto KYC
alt KYC != VERIFIED
  T ->> B : transaction.failed.v1 / FAILED\nsin mover dinero
else KYC VERIFIED
  T ->> B : account.debit.requested.v1
  B ->> A : Débito bajo SELECT FOR UPDATE
  note right of A
    NUMERIC(14,2), version y CHECK >= 0.
    AHORRO: Q3 de comisión; compensación la devuelve.
    Operaciones N/M -> account.anomaly.detected.v1.
  end note
  alt origen inválido o saldo insuficiente
    A ->> B : account.debit.rejected.v1
    B ->> T : FAILED
  else débito aplicado
    A ->> B : account.debited.v1
    B ->> T : DEBITING -> PAYMENT_PENDING
    T ->> B : payment.requested.v1
    B ->> P : Registrar pago e intento
    ref over P : Diagrama 11: reintentos 1 s / 5 s / 30 s
    alt pago exitoso
      P ->> B : payment.succeeded.v1
      B ->> T : Ordenar crédito
      T ->> B : account.credit.requested.v1
      B ->> A : Aplicar crédito idempotente
      alt crédito confirmado
        A ->> B : account.credited.v1
        B ->> T : COMPLETED
        T ->> B : transaction.completed.v1
      else crédito rechazado
        A ->> B : account.credit.rejected.v1
        B ->> T : Ordenar compensación
      end
    else rechazo definitivo o escalera agotada
      P ->> B : payment.failed.v1
      B ->> T : Ordenar compensación
    end
    opt compensación ordenada
      T ->> B : account.debit.compensation.requested.v1
      B ->> A : Reintegrar débito y comisión una vez
      A ->> B : account.debit.compensated.v1
      B ->> T : COMPENSATED
      T ->> B : transaction.compensated.v1
    end
  end
end
B ->> N : Eventos / redactar / registrar / notificar
T -> O : spans de Saga / resultado y duración
note over G,N
  AMQP conserva correlationId y traceparent; messageId deduplica consumo.
  Transaction y Payment persisten outbox antes del ack.
  Métricas usan etiquetas acotadas; IDs se consultan en logs/trazas.
  Una autotransición registra intentos sin cerrar la Saga.
end note

@enduml
