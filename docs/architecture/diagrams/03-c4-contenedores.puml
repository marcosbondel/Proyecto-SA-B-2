  .Element-RWxlbWVudCxDb250YWluZXIsVGVsZW1ldHJ5 {
    BackgroundColor: #f6f0ff;
    LineColor: #70519b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #70519b;
    FontSize: 22;
