  }
  // Compute Engine - cinco VMs privadas fuera de GKE
  .Group-Q29tcHV0ZSBFbmdpbmUgLSBjaW5jbyBWTXMgcHJpdmFkYXMgZnVlcmEgZGUgR0tF {
