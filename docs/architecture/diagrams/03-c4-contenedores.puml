    MaximumWidth: 390;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #f1f4f8;
    LineColor: #336791;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #336791;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
