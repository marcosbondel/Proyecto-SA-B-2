  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #ffffff;
    LineColor: #398819;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #398819;
    FontSize: 22;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 390;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #ffffff;
    LineColor: #ef9425;
    LineStyle: 0;
