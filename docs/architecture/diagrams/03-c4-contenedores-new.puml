person "==Cliente\n<size:15>[Person]</size>\n\nConsulta y opera sus cuentas; consulta seguimiento y notificaciones." <<Element-RWxlbWVudCxQZXJzb24=>> as Cliente
person "==Cajero receptor\n<size:15>[Person]</size>\n\nAtiende clientes en ventanilla con permisos D-06." <<Element-RWxlbWVudCxQZXJzb24=>> as Cajeroreceptor
person "==Administrador\n<size:15>[Person]</size>\n\nConsulta auditoría, pagos y notificaciones; configura la simulación por API." <<Element-RWxlbWVudCxQZXJzb24=>> as Administrador
person "==Operador / SRE\n<size:15>[Person]</size>\n\nDiagnostica métricas, trazas, logs y alertas en Grafana." <<Element-RWxlbWVudCxQZXJzb24=>> as OperadorSRE
rectangle "==Banco externo\n<size:15>[Software System]</size>\n\nContrato interbancario v1: HTTP 202, callback, consulta, cancelación y reverso." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Bancoexterno
rectangle "==Resend\n<size:15>[Software System]</size>\n\nEntrega real del correo de activación. También admite recuperación, rechazo de identidad y cambio de contraseña según evento." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Resend

rectangle "Bank USAC\n<size:15>[Software System]</size>" <<Boundary-QmFuayBVU0FD>> {
  rectangle "Compute Engine - cinco VMs privadas fuera de GKE" <<Group-Q29tcHV0ZSBFbmdpbmUgLSBjaW5jbyBWTXMgcHJpdmFkYXMgZnVlcmEgZGUgR0tF>> as groupQ29tcHV0ZSBFbmdpbmUgLSBjaW5jbyBWTXMgcHJpdmFkYXMgZnVlcmEgZGUgR0tF {
    database "==Customer DB\n<size:15>[Container: PostgreSQL 18.4 / pg]</size>\n\ncustomer / customer_dev; exclusiva de Customer." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as BankUSAC.CustomerDB
    database "==Account DB\n<size:15>[Container: PostgreSQL 18.4 / pg]</size>\n\naccount / account_dev; exclusiva de Account." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as BankUSAC.AccountDB
    database "==Transaction DB\n<size:15>[Container: PostgreSQL 18.4 / pg]</size>\n\ntransaction / transaction_dev; exclusiva de Transaction." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as BankUSAC.TransactionDB
    database "==Payment DB\n<size:15>[Container: PostgreSQL 18.4 / pg]</size>\n\npayment / payment_dev; exclusiva de Payment." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as BankUSAC.PaymentDB
    database "==Audit DB\n<size:15>[Container: PostgreSQL 18.4 / pg]</size>\n\nnotification_audit / notification_audit_dev; exclusiva de Audit." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as BankUSAC.AuditDB
  }

  rectangle "GKE - namespace dev o prod" <<Group-R0tFIC0gbmFtZXNwYWNlIGRldiBvIHByb2Q=>> as groupR0tFIC0gbmFtZXNwYWNlIGRldiBvIHByb2Q= {
    rectangle "==Customer Service\n<size:15>[Container: Node.js 24 / NestJS]</size>\n\nIdentidad, KYC, credenciales y eventos del ciclo de vida; verifica foto." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BankUSAC.CustomerService
    rectangle "==Account Service\n<size:15>[Container: Node.js 24 / NestJS]</size>\n\nSaldo exacto, comisión, liquidación y compensación; anomalía de frecuencia N/M." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BankUSAC.AccountService
    rectangle "==Transaction Service\n<size:15>[Container: Node.js 24 / NestJS]</size>\n\nSaga de seis estados, historial, outbox y medición de transiciones." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BankUSAC.TransactionService
    rectangle "==Payment Service\n<size:15>[Container: Node.js 24 / NestJS]</size>\n\nReintentos persistidos; simulación en caliente; envío/recepción y protocolo TIMEOUT interbancario." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BankUSAC.PaymentService
    rectangle "==Notification & Audit\n<size:15>[Container: Node.js 24 / NestJS]</size>\n\nAuditoría redactada, notificaciones y alertas; consulta por correlación, traza, servicio y nivel." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BankUSAC.NotificationAudit
    queue "==RabbitMQ\n<size:15>[Container: RabbitMQ / AMQP 0-9-1 (GKE observado: 3.13-management)]</size>\n\nComandos, eventos y request/reply. Volumen persistente por entorno." <<Element-RWxlbWVudCxDb250YWluZXIsQnJva2Vy>> as BankUSAC.RabbitMQ
    rectangle "==MinIO\n<size:15>[Container: API S3 compatible]</size>\n\nObjetos de identidad; Gateway escribe y Customer verifica." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BankUSAC.MinIO
    rectangle "==partner-bank-mock (opcional)\n<size:15>[Container: Node.js / HTTP :3021]</size>\n\nSimula contrato v1 y fallos. Observado en prod v1.3.6; ausente en dev el 2026-10-21; no es un sexto servicio de dominio." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BankUSAC.partnerbankmockopcional
    rectangle "==API Gateway\n<size:15>[Container: Node.js 24 / NestJS]</size>\n\nJWT y roles; REST, interbank/v1, alertas SLO y simulación. Sin BD ni lógica de negocio." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BankUSAC.APIGateway
  }

  rectangle "GKE - namespace observability" <<Group-R0tFIC0gbmFtZXNwYWNlIG9ic2VydmFiaWxpdHk=>> as groupR0tFIC0gbmFtZXNwYWNlIG9ic2VydmFiaWxpdHk= {
    rectangle "==otel-gateway\n<size:15>[Container: OpenTelemetry Collector / OTLP :4317,:4318]</size>\n\nDeployment: recibe trazas y métricas; redacta atributos sensibles." <<Element-RWxlbWVudCxDb250YWluZXIsVGVsZW1ldHJ5>> as BankUSAC.otelgateway
    rectangle "==otel-log-agent\n<size:15>[Container: OpenTelemetry Collector / filelog]</size>\n\nDaemonSet: lee stdout JSON en /var/log/pods, extrae contexto y redacta." <<Element-RWxlbWVudCxDb250YWluZXIsVGVsZW1ldHJ5>> as BankUSAC.otellogagent
    rectangle "==Prometheus\n<size:15>[Container: Prometheus / PromQL]</size>\n\nScrape, reglas de grabación y SLO; PVC 10 GiB, retención 7 días." <<Element-RWxlbWVudCxDb250YWluZXIsVGVsZW1ldHJ5>> as BankUSAC.Prometheus
    rectangle "==Tempo\n<size:15>[Container: Grafana Tempo / TraceQL]</size>\n\nTrazas correlacionadas; PVC 10 GiB, retención 7 días." <<Element-RWxlbWVudCxDb250YWluZXIsVGVsZW1ldHJ5>> as BankUSAC.Tempo
    rectangle "==Loki\n<size:15>[Container: Grafana Loki / LogQL]</size>\n\nLogs y metadatos de correlación; PVC 10 GiB, retención 7 días." <<Element-RWxlbWVudCxDb250YWluZXIsVGVsZW1ldHJ5>> as BankUSAC.Loki
    rectangle "==Grafana\n<size:15>[Container: Grafana 12.3.1 / PVC 2 GiB]</size>\n\nNueve dashboards, 16 alertas y Explore. LoadBalancer público; autenticación admin." <<Element-RWxlbWVudCxDb250YWluZXIsVGVsZW1ldHJ5>> as BankUSAC.Grafana
    rectangle "==kube-state-metrics\n<size:15>[Container: Kubernetes metrics / HTTP :8080]</size>\n\nEstado de Deployments, réplicas y HPA; señal de anotación de despliegue." <<Element-RWxlbWVudCxDb250YWluZXIsVGVsZW1ldHJ5>> as BankUSAC.kubestatemetrics
  }

  rectangle "==Frontend\n<size:15>[Container: Nuxt 4 / Vue 3 / Nitro]</size>\n\nSSR en Cloud Run; proxy Nitro hacia el Gateway. También existe carga web en GKE." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BankUSAC.Frontend
}

Cliente --> BankUSAC.Frontend <<Relationship-UmVsYXRpb25zaGlw>> : "Opera\n<size:11>[HTTPS :443]</size>"
Cajeroreceptor --> BankUSAC.Frontend <<Relationship-UmVsYXRpb25zaGlw>> : "Atiende\n<size:11>[HTTPS :443]</size>"
Administrador --> BankUSAC.Frontend <<Relationship-UmVsYXRpb25zaGlw>> : "Supervisa\n<size:11>[HTTPS :443]</size>"
OperadorSRE --> BankUSAC.Grafana <<Relationship-UmVsYXRpb25zaGlw>> : "Diagnostica y consulta\n<size:11>[HTTP :80 / sesión autenticada]</size>"
BankUSAC.Frontend --> BankUSAC.APIGateway <<Relationship-UmVsYXRpb25zaGlw>> : "Proxy SSR/API\n<size:11>[HTTP :3000 / REST JSON / correlationId]</size>"
BankUSAC.APIGateway --> BankUSAC.RabbitMQ <<Relationship-UmVsYXRpb25zaGlw>> : "Comandos, consultas y callback traducido a mensaje\n<size:11>[AMQP 0-9-1 :5672 / request-reply <=5 s]</size>"
BankUSAC.RabbitMQ --> BankUSAC.APIGateway <<Relationship-UmVsYXRpb25zaGlw>> : "Respuestas de dominio\n<size:11>[AMQP :5672 / correlationId + traceparent]</size>"
BankUSAC.RabbitMQ --> BankUSAC.CustomerService <<Relationship-UmVsYXRpb25zaGlw>> : "Comandos y KYC\n<size:11>[AMQP / asíncrono]</size>"
BankUSAC.CustomerService --> BankUSAC.RabbitMQ <<Relationship-UmVsYXRpb25zaGlw>> : "Respuestas y eventos de ciclo de vida\n<size:11>[AMQP / asíncrono]</size>"
BankUSAC.RabbitMQ --> BankUSAC.AccountService <<Relationship-UmVsYXRpb25zaGlw>> : "Movimientos y consultas\n<size:11>[AMQP / asíncrono]</size>"
BankUSAC.AccountService --> BankUSAC.RabbitMQ <<Relationship-UmVsYXRpb25zaGlw>> : "Veredictos y account.anomaly.detected.v1\n<size:11>[AMQP / asíncrono]</size>"
BankUSAC.RabbitMQ --> BankUSAC.TransactionService <<Relationship-UmVsYXRpb25zaGlw>> : "Solicitudes y eventos de Saga\n<size:11>[AMQP / asíncrono]</size>"
BankUSAC.TransactionService --> BankUSAC.RabbitMQ <<Relationship-UmVsYXRpb25zaGlw>> : "KYC, débito, pago, crédito y compensación\n<size:11>[AMQP / outbox / asíncrono]</size>"
BankUSAC.RabbitMQ --> BankUSAC.PaymentService <<Relationship-UmVsYXRpb25zaGlw>> : "Pagos, depósitos y resultados v1\n<size:11>[AMQP / asíncrono]</size>"
BankUSAC.PaymentService --> BankUSAC.RabbitMQ <<Relationship-UmVsYXRpb25zaGlw>> : "Veredictos, acciones de Account y respuestas\n<size:11>[AMQP / outbox / asíncrono]</size>"
BankUSAC.RabbitMQ --> BankUSAC.NotificationAudit <<Relationship-UmVsYXRpb25zaGlw>> : "Eventos y consultas de auditoría\n<size:11>[AMQP / asíncrono]</size>"
BankUSAC.NotificationAudit --> BankUSAC.RabbitMQ <<Relationship-UmVsYXRpb25zaGlw>> : "Sólo respuestas\n<size:11>[AMQP / request-reply]</size>"
BankUSAC.APIGateway --> BankUSAC.MinIO <<Relationship-UmVsYXRpb25zaGlw>> : "Deposita foto\n<size:11>[S3 / HTTP :9000]</size>"
BankUSAC.CustomerService --> BankUSAC.MinIO <<Relationship-UmVsYXRpb25zaGlw>> : "Verifica objeto y digest\n<size:11>[S3 / HTTP :9000]</size>"
BankUSAC.CustomerService --> BankUSAC.CustomerDB <<Relationship-UmVsYXRpb25zaGlw>> : "Sólo su base\n<size:11>[TCP :5432 / pg / SQL parametrizado]</size>"
BankUSAC.AccountService --> BankUSAC.AccountDB <<Relationship-UmVsYXRpb25zaGlw>> : "Sólo su base; row lock\n<size:11>[TCP :5432 / NUMERIC(14,2)]</size>"
BankUSAC.TransactionService --> BankUSAC.TransactionDB <<Relationship-UmVsYXRpb25zaGlw>> : "Sólo su base; estado + outbox\n<size:11>[TCP :5432 / transacción local]</size>"
BankUSAC.PaymentService --> BankUSAC.PaymentDB <<Relationship-UmVsYXRpb25zaGlw>> : "Sólo su base; reintentos y leases\n<size:11>[TCP :5432 / transacción local]</size>"
BankUSAC.NotificationAudit --> BankUSAC.AuditDB <<Relationship-UmVsYXRpb25zaGlw>> : "Sólo su base; payload redactado\n<size:11>[TCP :5432 / deduplicación]</size>"
BankUSAC.PaymentService --> Bancoexterno <<Relationship-UmVsYXRpb25zaGlw>> : "Contrato v1: envío, sondeo, cancelación y reverso\n<size:11>[HTTP(S) / JSON / X-Api-Key / traceparent]</size>"
Bancoexterno --> BankUSAC.APIGateway <<Relationship-UmVsYXRpb25zaGlw>> : "Depósitos y callbacks /interbank/v1/*\n<size:11>[HTTP :3000 / X-Api-Key / traceparent]</size>"
BankUSAC.PaymentService --> BankUSAC.partnerbankmockopcional <<Relationship-UmVsYXRpb25zaGlw>> : "Alternativa de prueba configurada explícitamente\n<size:11>[HTTP :3021 / contrato v1]</size>"
BankUSAC.partnerbankmockopcional --> BankUSAC.APIGateway <<Relationship-UmVsYXRpb25zaGlw>> : "Callback de prueba\n<size:11>[HTTP /interbank/v1/*]</size>"
BankUSAC.NotificationAudit --> Resend <<Relationship-UmVsYXRpb25zaGlw>> : "Correo de activación\n<size:11>[HTTPS :443 / API Resend]</size>"
BankUSAC.APIGateway -right-> BankUSAC.otelgateway <<Relationship-UmVsYXRpb25zaGlw>> : "Trazas y métricas\n<size:11>[OTLP gRPC :4317 o HTTP :4318]</size>"
BankUSAC.CustomerService -right-> BankUSAC.otelgateway <<Relationship-UmVsYXRpb25zaGlw>> : "Trazas y métricas\n<size:11>[OTLP / @bank/observability]</size>"
BankUSAC.AccountService -right-> BankUSAC.otelgateway <<Relationship-UmVsYXRpb25zaGlw>> : "Trazas y métricas\n<size:11>[OTLP / @bank/observability]</size>"
BankUSAC.TransactionService -right-> BankUSAC.otelgateway <<Relationship-UmVsYXRpb25zaGlw>> : "Trazas y métricas\n<size:11>[OTLP / @bank/observability]</size>"
BankUSAC.PaymentService -right-> BankUSAC.otelgateway <<Relationship-UmVsYXRpb25zaGlw>> : "Trazas y métricas\n<size:11>[OTLP / @bank/observability]</size>"
BankUSAC.NotificationAudit -right-> BankUSAC.otelgateway <<Relationship-UmVsYXRpb25zaGlw>> : "Trazas y métricas\n<size:11>[OTLP / @bank/observability]</size>"
BankUSAC.otelgateway --> BankUSAC.Tempo <<Relationship-UmVsYXRpb25zaGlw>> : "Exporta spans redactados\n<size:11>[OTLP gRPC :4317]</size>"
BankUSAC.Prometheus --> BankUSAC.otelgateway <<Relationship-UmVsYXRpb25zaGlw>> : "Scrape de métricas\n<size:11>[HTTP :8889 /metrics]</size>"
BankUSAC.otellogagent --> BankUSAC.Loki <<Relationship-UmVsYXRpb25zaGlw>> : "Logs de stdout; sin broker\n<size:11>[OTLP HTTP :3100 /otlp]</size>"
BankUSAC.Prometheus --> BankUSAC.Frontend <<Relationship-UmVsYXRpb25zaGlw>> : "Métricas web\n<size:11>[HTTP /metrics (carga web de GKE)]</size>"
BankUSAC.Prometheus --> BankUSAC.RabbitMQ <<Relationship-UmVsYXRpb25zaGlw>> : "Scrape del broker\n<size:11>[HTTP :15692 /metrics]</size>"
BankUSAC.Prometheus --> BankUSAC.kubestatemetrics <<Relationship-UmVsYXRpb25zaGlw>> : "Scrape de plataforma\n<size:11>[HTTP :8080 /metrics]</size>"
BankUSAC.Grafana --> BankUSAC.Prometheus <<Relationship-UmVsYXRpb25zaGlw>> : "SLI, SLO y error budget\n<size:11>[PromQL / HTTP]</size>"
BankUSAC.Grafana --> BankUSAC.Tempo <<Relationship-UmVsYXRpb25zaGlw>> : "Trazas\n<size:11>[TraceQL / HTTP :3200]</size>"
BankUSAC.Grafana --> BankUSAC.Loki <<Relationship-UmVsYXRpb25zaGlw>> : "Logs y salto a traza\n<size:11>[LogQL / HTTP :3100]</size>"
BankUSAC.Grafana --> BankUSAC.APIGateway <<Relationship-UmVsYXRpb25zaGlw>> : "Webhook POST /api/alerts/slo\n<size:11>[HTTP :3000 / token secreto]</size>"


' ==================== ALINEACIÓN Y NIVELES LIMPIOS ====================
Cliente -[hidden]right-> Cajeroreceptor
Cajeroreceptor -[hidden]right-> Administrador
Administrador -[hidden]right-> OperadorSRE

Cliente -[hidden]down-> BankUSAC.Frontend
Cajeroreceptor -[hidden]down-> BankUSAC.Frontend
Administrador -[hidden]down-> BankUSAC.Frontend
OperadorSRE -[hidden]down-> BankUSAC.Grafana

BankUSAC.Frontend -[hidden]down-> BankUSAC.APIGateway
BankUSAC.APIGateway -[hidden]down-> BankUSAC.RabbitMQ
BankUSAC.APIGateway -[hidden]left-> BankUSAC.MinIO

' Alinear los 5 microservicios en una fila ordenada
BankUSAC.CustomerService -[hidden]right-> BankUSAC.AccountService
BankUSAC.AccountService -[hidden]right-> BankUSAC.TransactionService
BankUSAC.TransactionService -[hidden]right-> BankUSAC.PaymentService
BankUSAC.PaymentService -[hidden]right-> BankUSAC.NotificationAudit

BankUSAC.RabbitMQ -[hidden]down-> BankUSAC.TransactionService

' Cada base de datos verticalmente debajo de su microservicio (sin cruces)
BankUSAC.CustomerService -[hidden]down-> BankUSAC.CustomerDB
BankUSAC.AccountService -[hidden]down-> BankUSAC.AccountDB
BankUSAC.TransactionService -[hidden]down-> BankUSAC.TransactionDB
BankUSAC.PaymentService -[hidden]down-> BankUSAC.PaymentDB
BankUSAC.NotificationAudit -[hidden]down-> BankUSAC.AuditDB

BankUSAC.CustomerDB -[hidden]right-> BankUSAC.AccountDB
BankUSAC.AccountDB -[hidden]right-> BankUSAC.TransactionDB
BankUSAC.TransactionDB -[hidden]right-> BankUSAC.PaymentDB
BankUSAC.PaymentDB -[hidden]right-> BankUSAC.AuditDB

' Observabilidad a la derecha sin cruzar la lógica de negocio
BankUSAC.NotificationAudit -[hidden]right-> BankUSAC.otelgateway

@enduml