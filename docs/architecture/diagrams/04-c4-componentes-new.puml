  rectangle "Transaction Service\n<size:16>[Container: Node.js 24 / NestJS / TypeScript]</size>" <<Boundary-VHJhbnNhY3Rpb24gU2VydmljZQ==>> {
    rectangle "==InboundMessageRouter\n<size:14>[Component: interfaces / dispatch]</size>\n\nEnruta por messageType; instancia por delivery y valida handler único." <<Element-RWxlbWVudCxDb21wb25lbnQsSW50ZXJmYWNlcw==>> as BankUSAC.TransactionService.InboundMessageRouter
    rectangle "==RequestTransferHandler\n<size:14>[Component: interfaces / AMQP / comando]</size>\n\ntransfer.requested.v1; Zod, identidad e idempotencyKey del envelope." <<Element-RWxlbWVudCxDb21wb25lbnQsSW50ZXJmYWNlcw==>> as BankUSAC.TransactionService.RequestTransferHandler
    rectangle "==TransactionStatusHandler\n<size:14>[Component: interfaces / AMQP / consulta]</size>\n\ntransaction.status.requested.v1; consulta por ID o correlación." <<Element-RWxlbWVudCxDb21wb25lbnQsSW50ZXJmYWNlcw==>> as BankUSAC.TransactionService.TransactionStatusHandler
    rectangle "==TransactionListHandler\n<size:14>[Component: interfaces / AMQP / consulta]</size>\n\ntransaction.list.query.v1; cuenta, fechas, estado y alcance del actor." <<Element-RWxlbWVudCxDb21wb25lbnQsSW50ZXJmYWNlcw==>> as BankUSAC.TransactionService.TransactionListHandler
    rectangle "==TransactionStatsHandler\n<size:14>[Component: interfaces / AMQP / consulta]</size>\n\ntransaction.stats.query.v1; contadores para personal autorizado." <<Element-RWxlbWVudCxDb21wb25lbnQsSW50ZXJmYWNlcw==>> as BankUSAC.TransactionService.TransactionStatsHandler
    rectangle "==PaymentAttemptFailedHandler\n<size:14>[Component: interfaces / AMQP / evento]</size>\n\npayment.attempt.failed.v1; registra intento sin cerrar PAYMENT_PENDING." <<Element-RWxlbWVudCxDb21wb25lbnQsSW50ZXJmYWNlcw==>> as BankUSAC.TransactionService.PaymentAttemptFailedHandler
    rectangle "==SagaEventHandler<T> + sagaHandlers()\n<size:14>[Component: interfaces / AMQP / eventos]</size>\n\nOcho bindings: KYC; débito y rechazo; pago y rechazo; crédito y rechazo; compensación." <<Element-RWxlbWVudCxDb21wb25lbnQsSW50ZXJmYWNlcw==>> as BankUSAC.TransactionService.SagaEventHandlerTsagaHandlers
    component "==DependencyHealthPort\n<size:14>[Component: interfaces / contrato de health]</size>\n\nBroker conectado, base alcanzable y consumidores; main.ts suministra closures." <<Element-RWxlbWVudCxDb21wb25lbnQsUG9ydA==>> as BankUSAC.TransactionService.DependencyHealthPort
    rectangle "==HealthController\n<size:14>[Component: interfaces / NestJS :3003]</size>\n\n/health: proceso vivo. /ready: broker, base y consumidores preparados." <<Element-RWxlbWVudCxDb21wb25lbnQsSW50ZXJmYWNlcw==>> as BankUSAC.TransactionService.HealthController
    rectangle "==RequestTransferUseCase\n<size:14>[Component: application / caso de uso]</size>\n\nValida solicitud, crea PENDING, conserva alias y abre la puerta KYC." <<Element-RWxlbWVudCxDb21wb25lbnQsQXBwbGljYXRpb24=>> as BankUSAC.TransactionService.RequestTransferUseCase
    rectangle "==GetTransactionStatusUseCase\n<size:14>[Component: application / caso de uso]</size>\n\nEstado, phaseStatus e historial real; sólo propietario o personal." <<Element-RWxlbWVudCxDb21wb25lbnQsQXBwbGljYXRpb24=>> as BankUSAC.TransactionService.GetTransactionStatusUseCase
    rectangle "==ListTransactionsUseCase\n<size:14>[Component: application / caso de uso]</size>\n\nListado acotado por identidad, cuentas, fechas y estados." <<Element-RWxlbWVudCxDb21wb25lbnQsQXBwbGljYXRpb24=>> as BankUSAC.TransactionService.ListTransactionsUseCase
    rectangle "==GetTransactionStatsUseCase\n<size:14>[Component: application / caso de uso]</size>\n\nAgrega contadores del monitor sin leer saldos." <<Element-RWxlbWVudCxDb21wb25lbnQsQXBwbGljYXRpb24=>> as BankUSAC.TransactionService.GetTransactionStatsUseCase
    rectangle "==RecordPaymentAttemptUseCase\n<size:14>[Component: application / caso de uso]</size>\n\nDeduplica y registra intento, error y willRetry; no transiciona Saga." <<Element-RWxlbWVudCxDb21wb25lbnQsQXBwbGljYXRpb24=>> as BankUSAC.TransactionService.RecordPaymentAttemptUseCase
    rectangle "==AdvanceSagaUseCase\n<size:14>[Component: application / caso de uso]</size>\n\nProporciona decide/applyEvent y efectos; repositorio ejecuta bajo row lock." <<Element-RWxlbWVudCxDb21wb25lbnQsQXBwbGljYXRpb24=>> as BankUSAC.TransactionService.AdvanceSagaUseCase
    component "==TransactionRepository\n<size:14>[Component: application / ports.ts]</size>\n\nstart, applyEvent, recordAlias, list, stats, transitionsOf y dispatchPendingOutbox." <<Element-RWxlbWVudCxDb21wb25lbnQsUG9ydA==>> as BankUSAC.TransactionService.TransactionRepository
    component "==EventPublisher\n<size:14>[Component: application / ports.ts]</size>\n\nsend/publish/reply y envelopeFor; separa construir outbox de enviar." <<Element-RWxlbWVudCxDb21wb25lbnQsUG9ydA==>> as BankUSAC.TransactionService.EventPublisher
    component "==TransferTelemetry\n<size:14>[Component: application / ports.ts]</size>\n\nopenTransfer, step y paymentAttempt; sin depender del SDK." <<Element-RWxlbWVudCxDb21wb25lbnQsUG9ydA==>> as BankUSAC.TransactionService.TransferTelemetry
    rectangle "==Transaction + applyEvent()\n<size:14>[Component: domain / TypeScript puro / transaction.ts]</size>\n\nPENDING, DEBITING, PAYMENT_PENDING, COMPLETED, FAILED, COMPENSATED; transición ilegal rechazada." <<Element-RWxlbWVudCxDb21wb25lbnQsRG9tYWlu>> as BankUSAC.TransactionService.TransactionapplyEvent
    rectangle "==Money / amountProblem()\n<size:14>[Component: domain / TypeScript puro / money.ts]</size>\n\nMonto positivo y precisión exacta; no consulta ni calcula saldo disponible." <<Element-RWxlbWVudCxDb21wb25lbnQsRG9tYWlu>> as BankUSAC.TransactionService.MoneyamountProblem
    rectangle "==phaseStatusOf() / statusesInPhase()\n<size:14>[Component: domain / TypeScript puro / phase-status.ts]</size>\n\nProyección PENDING / APPROVED / FAILED sin sustituir los seis estados." <<Element-RWxlbWVudCxDb21wb25lbnQsRG9tYWlu>> as BankUSAC.TransactionService.phaseStatusOfstatusesInPhase
    rectangle "==MessageBroker\n<size:14>[Component: infrastructure / @bank/messaging]</size>\n\ntransaction.commands + transaction.saga; ack, retry 1/5/30 s, DLQ y contexto W3C." <<Element-RWxlbWVudCxDb21wb25lbnQsSW5mcmFzdHJ1Y3R1cmU=>> as BankUSAC.TransactionService.MessageBroker
    rectangle "==BrokerEventPublisher\n<size:14>[Component: infrastructure / AMQP + Zod]</size>\n\nImplementa EventPublisher; forCause conserva correlación, causalidad e identidad." <<Element-RWxlbWVudCxDb21wb25lbnQsSW5mcmFzdHJ1Y3R1cmU=>> as BankUSAC.TransactionService.BrokerEventPublisher
    rectangle "==PostgresTransactionRepository\n<size:14>[Component: infrastructure / PostgreSQL + pg]</size>\n\nFOR UPDATE; dedup messageId; estado, transición y outbox atómicos; pg parametrizado." <<Element-RWxlbWVudCxDb21wb25lbnQsSW5mcmFzdHJ1Y3R1cmU=>> as BankUSAC.TransactionService.PostgresTransactionRepository
    rectangle "==OutboxRelay\n<size:14>[Component: infrastructure / AdaptiveTicker]</size>\n\ndispatchPendingOutbox: SKIP LOCKED y publish con contexto; tick 200 ms, idle hasta 2 s." <<Element-RWxlbWVudCxDb21wb25lbnQsSW5mcmFzdHJ1Y3R1cmU=>> as BankUSAC.TransactionService.OutboxRelay
    rectangle "==OtelTransferTelemetry\n<size:14>[Component: infrastructure / OTLP]</size>\n\nSpans saga.*, duración y resultado; IDs en logs/trazas y etiquetas acotadas." <<Element-RWxlbWVudCxDb21wb25lbnQsSW5mcmFzdHJ1Y3R1cmU=>> as BankUSAC.TransactionService.OtelTransferTelemetry
  }

  database "==Transaction DB\n<size:16>[Container: PostgreSQL 18.4 / TCP :5432]</size>\n\nSiete tablas propias, incluido schema_migrations; ninguna lectura a otra base." <<Element-RWxlbWVudCxEYXRhYmFzZQ==>> as BankUSAC.TransactionDB
