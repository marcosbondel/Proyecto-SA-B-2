flowchart LR
    users(["Cliente / Cajero / Administrador"])
    email["Servicio de correo"]
    provider["Proveedor de pagos"]

    subgraph cluster["Límite del clúster – kind"]
        frontend["Frontend"]
        gateway["API Gateway"]
        subgraph micro["Microservicios"]
            customer["Customer Service"]
            account["Account Service"]
            transaction["Transaction Service"]
            payment["Payment Service"]
            notification["Notification & Audit Service"]
        end
    end

    subgraph external["Infraestructura externa (fuera del clúster)"]
        broker[("Broker de mensajería")]
        minio[("Almacenamiento de objetos")]
        subgraph datos["Datos"]
            customerDb[("Datos de Customer")]
            accountDb[("Datos de Account")]
            transactionDb[("Datos de Transaction")]
            paymentDb[("Datos de Payment")]
            notificationDb[("Datos de Notification & Audit")]
        end
    end

    users --> frontend
    frontend -->|Síncrono| gateway
    gateway <-->|Asíncrono| broker
    broker <-->|Asíncrono| customer
    broker <-->|Asíncrono| account
    broker <-->|Asíncrono| transaction
    broker <-->|Asíncrono| payment
    broker <-->|Asíncrono| notification

    customer --> customerDb
    account --> accountDb
    transaction --> transactionDb
    payment --> paymentDb
    notification --> notificationDb

    gateway -->|Síncrono| minio
    customer -->|Síncrono| minio
    notification --> email
    payment --> provider

    classDef service fill:#DCEBFF,stroke:#1168BD,color:#0B2447;
    classDef gatewayNode fill:#FFE8CC,stroke:#C1701A,color:#5A3400;
    classDef db fill:#E7F7EA,stroke:#2E8B45,color:#0B3D19;
    classDef ext fill:#FFFFFF,stroke:#666666,color:#333333;

    class frontend,customer,account,transaction,payment,notification service;
    class gateway,broker gatewayNode;
    class customerDb,accountDb,transactionDb,paymentDb,notificationDb,minio db;
    class users,email,provider ext;
