    classDef db fill:#fce4ec,stroke:#ad1457,stroke-width:2px,color:#0d1b2a;
    classDef legend fill:#fafafa,stroke:#9e9e9e,stroke-width:1px,color:#212121;
    classDef note fill:#fff8dc,stroke:#d6b656,stroke-width:1px,color:#555555;

    class WEB frontend;
    class GW gateway;
    class CUS,ACC,TRX,PAY,NOT service;
