@startuml 05-uml-despliegue
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 14
skinparam dpi 180
skinparam ArrowColor #60666F
skinparam defaultTextAlignment center
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 65
skinparam nodeBackgroundColor #F7F7F7
skinparam nodeBorderColor #7A7F87
skinparam rectangleBackgroundColor #FFFFFF
skinparam rectangleBorderColor #1168BD
skinparam databaseBackgroundColor #EDF3F8
skinparam databaseBorderColor #336791
skinparam noteBackgroundColor #FFF8DE
skinparam noteBorderColor #D6B656
title UML - Despliegue LOCAL - Bank USAC Fase III\nVista distinta del despliegue GCP (diagrama 08)
left to right direction
actor "Desarrollador / navegador" as user
node "Host local - Docker Engine" {
  artifact "pnpm local:up\nkind + Helm\nchart bank-usac\nchart bank-observability" as tools
  node "kind-bank-usac\nKubernetes" {
    node "namespace bank-usac" {
      artifact "7 Deployments\nGateway NestJS :3000\nWeb Nuxt 4 :3010\n5 servicios NestJS :3001-3005" as apps
      artifact "Services ClusterIP\nConfigMap + Secret\nhealth / ready / HPA" as svc
      artifact "partner-bank-mock\nopcional / HTTP :3021" as mock
    }
    node "namespace observability" {
      artifact "Collector Deployment\nOTLP :4317,:4318" as collector
      artifact "Log agent DaemonSet\nfilelog /var/log/pods" as agent
      artifact "Prometheus 2h / sin PVC\nTempo 24h / PVC 5 GiB\nLoki / PVC 2 GiB (overlay kind)" as stores
      artifact "Grafana / kube-state-metrics\nport-forward" as grafana
    }
  }
  node "Fuera de kind - red Docker" {
    database "5 PostgreSQL 18.4\npuertos host 5433-5437\nTCP :5432 desde pods" as pg
    queue "RabbitMQ\nAMQP host :5673\nscrape :15692" as rabbit
    database "MinIO\nAPI S3 host :9002" as minio
  }
}
user --> svc : kubectl port-forward\nGateway :3000 / Web :3010
tools ..> apps : Helm install/upgrade
tools ..> collector : Helm install/upgrade
apps --> pg : SQL / sólo su base
apps <--> rabbit : AMQP 0-9-1\ncorrelationId + traceparent
apps --> minio : Gateway escribe / Customer verifica
apps ..> collector : OTLP / 6 NestJS
agent --> stores : logs OTLP -> Loki
collector --> stores : métricas y trazas
grafana --> stores : PromQL / TraceQL / LogQL
grafana --> apps : webhook /api/alerts/slo
note bottom of tools
  Terraform aprovisiona GCP (vista 08), no este host.
  Endpoints de dependencias externas descubiertos por scripts.
  No ejecutar suites con TRUNCATE contra bases de la demo.
end note

@enduml
