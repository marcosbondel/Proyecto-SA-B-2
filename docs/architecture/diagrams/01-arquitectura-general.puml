@startuml 01-arquitectura-general

title Bank USAC - Arquitectura general

left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 65
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam ArrowColor #555555
skinparam ArrowThickness 1.2

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #398819
    FontColor #398819
}
skinparam cloud {
    BackgroundColor #FFF0F0
    BorderColor #C11926
    FontColor #C11926
}
skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #1168BD
    FontColor #1168BD
}
skinparam database {
    BackgroundColor #FFFFFF
    BorderColor #1168BD
    FontColor #1168BD
}
skinparam rectangle {
    BackgroundColor #F7F9FC
    BorderColor #777777
    FontColor #333333
}

actor "Cliente / Cajero /\nAdministrador" as users
cloud "Servicio de correo" as email
cloud "Proveedor de pagos" as provider

rectangle "Bank USAC" as system {
    rectangle "Entorno de aplicaciones" as applications {
        node "Frontend" as frontend
        node "API Gateway" as gateway

        together {
            node "Customer Service" as customer
            node "Account Service" as account
            node "Transaction Service" as transaction
        }

        together {
            node "Payment Service" as payment
            node "Notification & Audit" as notification
        }
    }

    rectangle "Infraestructura de soporte" as support {
        node "Bus de mensajería\n(colas y eventos)" as broker

        together {
            database "Customer" as customerDb
            database "Account" as accountDb
            database "Transaction" as transactionDb
            database "Payment" as paymentDb
            database "Notification & Audit" as notificationDb
        }

        node "Almacenamiento\nde objetos" as objectStore
    }
}

users --> frontend : interactúa
frontend --> gateway : solicita
gateway <--> broker : publica / recibe mensajes
broker <--> customer : distribuye mensajes
broker <--> account : distribuye mensajes
broker <--> transaction : distribuye mensajes
broker <--> payment : distribuye mensajes
broker --> notification : distribuye eventos

customer --> customerDb : persiste datos
account --> accountDb : persiste datos
transaction --> transactionDb : persiste datos
payment --> paymentDb : persiste datos
notification --> notificationDb : persiste datos

gateway --> objectStore : transfiere archivos
customer --> objectStore : consulta archivos
notification --> email : envía notificaciones
payment --> provider : solicita pagos

note right of broker
    Canal lógico compartido para la comunicación
    entre el Gateway y los servicios.
    Las colas y los eventos se detallan en
    los diagramas de contenedores y mensajería.
end note

note bottom of support
    La infraestructura de soporte permanece separada
    del entorno donde se ejecutan las aplicaciones.
end note

@enduml
