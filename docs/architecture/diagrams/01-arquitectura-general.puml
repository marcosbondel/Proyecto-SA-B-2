@startuml 01-arquitectura-general

title Bank USAC – Arquitectura general

left to right direction
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #555555
skinparam ArrowThickness 1.2

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #333333
    FontColor #222222
}
skinparam database {
    BackgroundColor #E7F7EA
    BorderColor #2E8B45
    FontColor #0B3D19
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #555555
    FontColor #333333
}

actor "Cliente / Cajero /\nAdministrador" as users
rectangle "Servicio de correo" as email #F2F2F2
rectangle "Proveedor de pagos" as provider #F2F2F2

rectangle "Límite del clúster – kind" as cluster #EAF2FF {
    rectangle "Frontend" as frontend #DCEBFF
    rectangle "API Gateway" as gateway #FFE8CC

    rectangle "Microservicios" as micro {
        rectangle "Customer Service" as customer #DCEBFF
        rectangle "Account Service" as account #DCEBFF
        rectangle "Transaction Service" as transaction #DCEBFF
        rectangle "Payment Service" as payment #DCEBFF
        rectangle "Notification & Audit Service" as notification #DCEBFF
    }
}

rectangle "Infraestructura externa (fuera del clúster)" as external #FFF7E6 {
    rectangle "Broker de mensajería" as broker #FFE8CC
    database "Almacenamiento de objetos" as minio

    rectangle "Datos" as datos {
        database "Datos de Customer" as customerDb
        database "Datos de Account" as accountDb
        database "Datos de Transaction" as transactionDb
        database "Datos de Payment" as paymentDb
        database "Datos de Notification & Audit" as notificationDb
    }
}

users --> frontend
frontend --> gateway : Síncrono
gateway <--> broker : Asíncrono
broker <--> customer : Asíncrono
broker <--> account : Asíncrono
broker <--> transaction : Asíncrono
broker <--> payment : Asíncrono
broker <--> notification : Asíncrono

customer --> customerDb
account --> accountDb
transaction --> transactionDb
payment --> paymentDb
notification --> notificationDb

gateway --> minio : Síncrono
customer --> minio : Síncrono
notification --> email
payment --> provider

@enduml
