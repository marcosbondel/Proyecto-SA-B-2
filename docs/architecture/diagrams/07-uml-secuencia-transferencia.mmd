%% Bank USAC - UML 2 Sequence Diagram - Transferencia bancaria
%% Caso de uso 6 (docs/domain/use-cases.md). Saga por coreografia con compensacion
%% explicita, cuatro servicios, comunicados solo por RabbitMQ. Un solo diagrama:
%% camino feliz, los tres finales (COMPLETED / FAILED / COMPENSATED) y la
%% compensacion con sus dos disparadores.
%% Cada mensaje declara la accion de negocio y, entre corchetes, su tecnologia,
%% protocolo y tipo de interaccion (sincrona o asincrona; comando, evento o
%% request/reply), como exige el enunciado (§4.2, "Tipo de comunicacion") — misma
%% convencion que 06-uml-secuencia-crear-cuenta.mmd.
%% Debe coincidir con el .puml equivalente en TODAS las etiquetas.

sequenceDiagram
    autonumber
    actor Usr as "Actor (CLIENTE / CAJERO_RECEPTOR / ADMINISTRADOR)"
    participant Frontend
    participant Gateway as "API Gateway"
    participant Broker as "Message Broker<br/>(RabbitMQ)"
    participant Txn as "Transaction Service"
    participant Acc as "Account Service"
    participant Pay as "Payment Service"
    participant Notif as "Notification & Audit"

    Usr->>Frontend: Solicitar transferencia<br/>[interacción de usuario · navegador · síncrono]
    Frontend->>Gateway: Enviar sourceAccount, targetAccount, amount, idempotencyKey<br/>[HTTPS/REST · POST /api/transfers · síncrono]
    Note over Gateway: Genera un identificador de seguimiento (correlationId)
    Gateway->>Broker: Publicar comando "transferir" — transfer.requested (correlationId)<br/>[AMQP 0-9-1 · comando · asíncrono]
    Gateway-->>Frontend: Confirmar recepción — 202 Accepted<br/>[HTTPS/REST · respuesta síncrona]
    Frontend-->>Usr: "Solicitud recibida" (NO "transferencia completada")

    %% Paso 1
    Broker->>Txn: Entregar transfer.requested (correlationId)<br/>[AMQP 0-9-1 · entrega de comando · asíncrono]
    alt datos inválidos o idempotencyKey en conflicto (T-1, T-2, T-4)
        Note over Txn: Rechazado — no se crea la Transaction
        Txn->>Broker: Confirmar (ack) — rechazo registrado<br/>[AMQP basic.ack]
    else idempotencyKey repetida, mismo contenido (T-3)
        Note over Txn: Devuelve la transacción original — balances sin mover
        Txn->>Broker: Confirmar (ack)<br/>[AMQP basic.ack]
    else datos válidos, idempotencyKey nueva
        Note over Txn: Crea la Transaction — PENDING -> DEBITING
        Txn->>Broker: Publicar comando "debitar" — account.debit.requested (correlationId)<br/>[AMQP 0-9-1 · comando · asíncrono]
        Txn->>Broker: Confirmar (ack) — DESPUÉS de guardar<br/>[AMQP basic.ack]

        %% Paso 2
        Broker->>Acc: Entregar account.debit.requested (correlationId)<br/>[AMQP 0-9-1 · entrega de comando · asíncrono]
        alt fondos insuficientes o cuenta origen inactiva (A-1 / A-2) — cierra en FAILED
            Note over Acc: Rechazado — el débito no se aplica
            Acc->>Broker: Publicar evento "débito rechazado" — account.debit.rejected (ack)<br/>[AMQP 0-9-1 · evento · asíncrono]
            Broker->>Txn: Entregar account.debit.rejected (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
            Note over Txn: DEBITING -> FAILED — nada que deshacer (invariante T-7)
            Txn->>Broker: Publicar evento "transacción fallida" — transaction.failed (ack)<br/>[AMQP 0-9-1 · evento · asíncrono]
            Broker->>Notif: Entregar transaction.failed (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
            Note over Notif: Registra el cierre y notifica al cliente — FAILED
        else débito aplicado
            Acc->>Broker: Publicar evento "cuenta debitada" — account.debited (ack)<br/>[AMQP 0-9-1 · evento · asíncrono]

            %% Paso 3
            Broker->>Txn: Entregar account.debited (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
            Note over Txn: DEBITING -> PAYMENT_PENDING
            Txn->>Broker: Publicar comando "procesar pago" — payment.requested (ack)<br/>[AMQP 0-9-1 · comando · asíncrono]

            %% Paso 4
            Broker->>Pay: Entregar payment.requested (correlationId)<br/>[AMQP 0-9-1 · entrega de comando · asíncrono]
            Note over Pay: Registra el pago en PENDING y ejecuta el intento 1. El momento del siguiente intento<br/>se guarda como columna (next_attempt_at, con índice parcial): NO es un temporizador en memoria

            %% Paso 4b: la escalera de reintentos, un intento por barrido
            loop por cada intento fallido transitorio que aún tenga peldaño (1 s / 5 s / 30 s)
                Pay->>Broker: Publicar evento "intento de pago fallido" — payment.attempt.failed (attempt, errorType, willRetry = true, nextAttemptAt)<br/>[AMQP 0-9-1 · evento · asíncrono]
                Broker->>Txn: Entregar payment.attempt.failed (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
                Note over Txn: Evento observable, NO terminal: la Saga sigue en PAYMENT_PENDING
                Note over Pay: el siguiente intento no ocurre dentro de esta entrega: vence en next_attempt_at
                Pay->>Pay: Barrer los pagos vencidos — SELECT ... WHERE next_attempt_at <= now() ... FOR UPDATE SKIP LOCKED<br/>[RetryScheduler · barrido periódico sobre la propia base · asíncrono]
                Note over Pay: El vencimiento es una columna, así que un pod reprogramado no olvida el reintento
            end
            alt escalera agotada o pago rechazado — dispara compensación
                Pay->>Broker: Publicar evento "intento de pago fallido" — payment.attempt.failed (attempt, errorType, willRetry = false)<br/>[AMQP 0-9-1 · evento · asíncrono]
                Pay->>Broker: Publicar evento "pago fallido" — payment.failed (failureReason, ack)<br/>[AMQP 0-9-1 · evento terminal, el único que cierra la Saga · asíncrono]
                Broker->>Txn: Entregar payment.failed (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
                Note over Txn: Débito ya aplicado -> requiere compensación (T-7)
            else algún intento tiene éxito
                Pay->>Broker: Publicar evento "pago exitoso" — payment.succeeded (attempt, ack)<br/>[AMQP 0-9-1 · evento terminal, el único que cierra la Saga · asíncrono]

                %% Paso 5
                Broker->>Txn: Entregar payment.succeeded (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
                Note over Txn: Ordena el crédito
                Txn->>Broker: Publicar comando "acreditar" — account.credit.requested (ack)<br/>[AMQP 0-9-1 · comando · asíncrono]

                %% Paso 6
                Broker->>Acc: Entregar account.credit.requested (correlationId)<br/>[AMQP 0-9-1 · entrega de comando · asíncrono]
                alt cuenta destino no encontrada — dispara compensación
                    Acc->>Broker: Publicar evento "crédito rechazado" — account.credit.rejected (ack)<br/>[AMQP 0-9-1 · evento · asíncrono]
                    Broker->>Txn: Entregar account.credit.rejected (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
                    Note over Txn: Débito ya aplicado -> requiere compensación (T-7)
                else destino encontrado
                    Note over Acc: Acredita el destino, lo reactiva si estaba INACTIVE (A-3)
                    Acc->>Broker: Publicar evento "cuenta acreditada" — account.credited (ack)<br/>[AMQP 0-9-1 · evento · asíncrono]

                    %% Paso 7
                    Broker->>Txn: Entregar account.credited (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
                    Note over Txn: PAYMENT_PENDING -> COMPLETED
                    Txn->>Broker: Publicar evento "transacción completada" — transaction.completed (ack)<br/>[AMQP 0-9-1 · evento · asíncrono]
                    Broker->>Notif: Entregar transaction.completed (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
                    Note over Notif: Registra el cierre y notifica al cliente — COMPLETED
                end
            end

            opt requiere compensación — disparada por payment.failed o account.credit.rejected
                Txn->>Broker: Publicar comando "compensar débito" — account.debit.compensation.requested (correlationId)<br/>[AMQP 0-9-1 · comando de compensación · asíncrono]
                Broker->>Acc: Entregar account.debit.compensation.requested (correlationId)<br/>[AMQP 0-9-1 · entrega de comando · asíncrono]
                Note over Acc: Devuelve el monto a la cuenta origen
                Acc->>Broker: Publicar evento "débito compensado" — account.debit.compensated (ack)<br/>[AMQP 0-9-1 · evento · asíncrono]
                Broker->>Txn: Entregar account.debit.compensated (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
                Note over Txn: PAYMENT_PENDING -> COMPENSATED — el dinero salió y volvió
                Txn->>Broker: Publicar evento "transacción compensada" — transaction.compensated (ack)<br/>[AMQP 0-9-1 · evento · asíncrono]
                Broker->>Notif: Entregar transaction.compensated (correlationId)<br/>[AMQP 0-9-1 · entrega de evento · asíncrono]
                Note over Notif: Registra el cierre y notifica al cliente — COMPENSATED
            end
        end
    end

    Note over Usr,Gateway: El estado real se consulta después por transactionId: GET /api/transfers/:id llega al<br/>Transaction Service como request/reply sobre AMQP, con un techo de 5 s.
    Note over Txn,Acc: Transaction Service NUNCA lee el balance: ordena el débito/crédito y espera el evento (bounded-contexts.md)
    Note over Txn: Evento repetido se descarta por el messageId del envelope (T-5), transición fuera de orden se descarta como ILLEGAL_TRANSITION (T-6)
