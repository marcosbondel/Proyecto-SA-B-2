erDiagram
    payments ||--o{ payment_attempts : "intenta"
    payments ||--o{ outbox_messages : "encola"

    payments {
        uuid payment_id PK
        uuid transaction_id UK
        numeric amount
        varchar status
        integer attempt
        varchar error_type
        text failure_reason
        varchar provider_reference
        varchar scenario
        uuid origin_correlation_id
        timestamptz next_attempt_at
        timestamptz created_at
        timestamptz updated_at
        timestamptz decided_at
    }

    payment_attempts {
        uuid payment_id PK,FK
        integer attempt_number PK
        varchar result
        varchar error_type
        text failure_reason
        timestamptz occurred_at
    }

    outbox_messages {
        bigserial id PK
        uuid payment_id FK
        varchar exchange
        varchar routing_key
        jsonb envelope
        varchar dispatch_status
        timestamptz created_at
        timestamptz published_at
    }
