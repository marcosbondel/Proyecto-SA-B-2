// Payment Service - Entity-Relationship Diagram (DBML)
// Database: payment_db (PostgreSQL 18.4)

Table payments {
  payment_id uuid [pk]
  transaction_id uuid [unique, not null, note: 'Transacción origen que ordenó el pago']
  amount numeric(14,2) [not null, note: 'Monto a pagar']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, SUCCEEDED, FAILED']
  attempt integer [note: 'Número de intento actual']
  error_type varchar(20) [note: 'TRANSIENT, PERMANENT']
  failure_reason text [note: 'PAYMENT_DECLINED, PAYMENT_RETRIES_EXHAUSTED']
  provider_reference varchar(100) [note: 'Referencia del proveedor externo']
  scenario varchar(20) [note: 'Escenario simulado: APPROVE, REJECT, TRANSIENT_FAILURE']
  origin_correlation_id uuid [note: 'Correlación de la transferencia original']
  next_attempt_at timestamptz [note: 'Hora programada para el siguiente intento']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  decided_at timestamptz

  indexes {
    transaction_id [unique, name: 'payments_transaction_key']
    next_attempt_at [name: 'payments_due_idx', note: 'WHERE status = PENDING AND next_attempt_at IS NOT NULL']
    status [name: 'payments_status_idx']
  }
  Note: 'Gestión de pagos a facturadores y proveedores externos'
}

Table payment_attempts {
  payment_id uuid [not null, ref: > payments.payment_id]
  attempt_number integer [not null]
  result varchar(20) [not null, note: 'SUCCEEDED, FAILED']
  error_type varchar(20) [note: 'TRANSIENT, PERMANENT']
  failure_reason text
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (payment_id, attempt_number) [pk]
  }
  Note: 'Historial inmutable de cada intento de pago en la escalera de reintentos'
}

Table outbox_messages {
  id bigserial [pk]
  payment_id uuid [not null, ref: > payments.payment_id]
  exchange varchar(120) [not null]
  routing_key varchar(200) [not null]
  envelope jsonb [not null, note: 'Envolvente del evento de intento o resultado']
  dispatch_status varchar(20) [not null, default: 'PENDING', note: 'PENDING, DISPATCHED']
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz

  indexes {
    id [name: 'outbox_messages_pending_idx', note: 'WHERE dispatch_status = PENDING']
  }
  Note: 'Transactional Outbox para publicación confiable de eventos de pago'
}
