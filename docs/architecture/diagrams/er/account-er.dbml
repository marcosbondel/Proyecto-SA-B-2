// T-61 — esquema físico acumulado. PostgreSQL 18.4; no FK entre servicios.
// 10 migraciones + schema_migrations; revisión 2026-10-21.
Project account_db {
  database_type: 'PostgreSQL'
  Note: '''Account Service. Resultado acumulado del DDL versionado; no es evidencia de migraciones aplicadas en cloud.'''
}

Table accounts {
  account_id uuid [pk, not null]
  customer_id uuid [not null]
  account_type varchar(10) [not null]
  balance numeric(14,2) [not null, default: 0.00]
  status varchar(10) [not null, default: 'ACTIVE']
  last_activity_at timestamptz [not null, default: `now()`]
  version integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  biller_code varchar(20)
  biller_name varchar(60)
  account_number varchar(34) [not null, default: `'02-' || lpad(nextval('account_number_seq')::text, 9, '0')`]

  indexes {
    (account_number) [unique, name: 'accounts_account_number_key']
    (customer_id) [name: 'accounts_customer_idx']
    (status, last_activity_at) [name: 'accounts_inactivity_idx']
    (biller_code) [unique, name: 'accounts_biller_code_once', note: "WHERE biller_code IS NOT NULL"]
  }

  Note: '''Único propietario de saldos; SELECT FOR UPDATE, versión optimista y CHECK balance >= 0. account_number público; customer_id es referencia opaca.

Restricciones SQL:
accounts_type_known: CHECK (account_type IN ('MONETARIA', 'AHORRO'))
accounts_status_known: CHECK (status IN ('ACTIVE', 'INACTIVE'))
accounts_balance_not_negative: CHECK (balance >= 0)
accounts_account_number_format: CHECK (account_number ~ '^[A-Za-z0-9-]{1,34}$')'''
}

Table account_operations {
  operation_id uuid [pk, not null]
  account_id uuid [not null]
  type varchar(20) [not null]
  amount numeric(14,2) [not null]
  balance_after numeric(14,2) [not null]
  transaction_id uuid
  status varchar(20) [not null, default: 'APPLIED']
  idempotency_key varchar(200) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (idempotency_key, type) [unique, name: 'account_operations_once']
    (account_id, `created_at DESC`) [name: 'account_operations_account_idx']
    (transaction_id) [name: 'account_operations_transaction_idx']
    (transaction_id, type) [unique, name: 'account_operations_transaction_type_once', note: "WHERE transaction_id IS NOT NULL"]
  }

  Note: '''Movimientos DEBIT, CREDIT, COMPENSATION y COMMISSION. La comisión se revierte junto al débito.

Restricciones SQL:
account_operations_status_known: CHECK (status IN ('APPLIED', 'COMPENSATED'))
account_operations_amount_positive: CHECK (amount > 0)
account_operations_type_known: CHECK (type IN ('DEBIT', 'CREDIT', 'COMPENSATION', 'COMMISSION'))'''
}

Table processed_messages {
  message_id uuid [pk, not null]
  idempotency_key varchar(200) [not null]
  message_type varchar(120) [not null]
  result_summary jsonb [not null]
  processed_at timestamptz [not null, default: `now()`]

  indexes {
    (idempotency_key, message_type) [unique, name: 'processed_messages_once']
  }

  Note: '''Deduplicación local. La clave real depende del servicio: message_id, par con consumer o idempotency_key/message_type.'''
}

Table deactivation_runs {
  run_id uuid [pk, not null]
  executed_at timestamptz [not null]
  threshold_at timestamptz [not null]
  min_balance_minor bigint [not null]
  deactivated_count integer [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: '''Evidencia del job: también registra cero cuentas desactivadas.'''
}

Table account_anomalies {
  anomaly_id uuid [pk, not null]
  account_id uuid [not null]
  rule varchar(40) [not null, default: 'HIGH_FREQUENCY']
  operation_count integer [not null]
  threshold integer [not null]
  window_minutes integer [not null]
  window_start timestamptz [not null]
  detected_at timestamptz [not null]
  claimed_at timestamptz [not null]
  published_at timestamptz

  indexes {
    (account_id, `detected_at DESC`) [name: 'account_anomalies_account_idx']
  }

  Note: '''Alta frecuencia; reporta y no bloquea. Reclamo/publicación persistidos.

Restricciones SQL:
account_anomalies_exceeds_limit: CHECK (operation_count > threshold)'''
}

Table schema_migrations {
  name varchar(120) [pk, not null]
  applied_at timestamptz [not null, default: `now()`]

  Note: '''Infraestructura del migrador, no entidad de dominio. Se crea fuera de MIGRATIONS antes de aplicarlas; una tabla en cada base.'''
}

Ref: account_operations.account_id > accounts.account_id [delete: no action]
Ref: account_anomalies.account_id > accounts.account_id [delete: no action]
