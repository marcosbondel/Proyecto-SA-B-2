// T-61 — esquema físico acumulado. PostgreSQL 18.4; no FK entre servicios.
// 12 migraciones + schema_migrations; revisión 2026-10-21.
Project transaction_db {
  database_type: 'PostgreSQL'
  Note: '''Transaction Service. Resultado acumulado del DDL versionado; no es evidencia de migraciones aplicadas en cloud.'''
}

Table transactions {
  transaction_id uuid [pk, not null]
  source_account uuid [not null]
  target_account uuid [not null]
  amount numeric(14,2) [not null]
  status varchar(20) [not null, default: 'PENDING']
  correlation_id uuid [not null]
  idempotency_key varchar(200) [not null]
  failure_reason text
  payment_scenario varchar(20)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  customer_id uuid
  reference varchar(60)
  requested_at timestamptz
  trace_context varchar(80)
  interbank jsonb

  indexes {
    (idempotency_key) [unique, name: 'transactions_idempotency_once']
    (correlation_id) [name: 'transactions_correlation_idx']
    (source_account, `created_at DESC`) [name: 'transactions_source_idx']
    (target_account, `created_at DESC`) [name: 'transactions_target_idx']
    (customer_id, `created_at DESC`) [name: 'transactions_customer_idx']
  }

  Note: '''Saga de seis estados. customer_id, cuentas e interbank son referencias/contexto; no consulta saldos ajenos.

Restricciones SQL:
transactions_status_known: CHECK (status IN ('PENDING','DEBITING','PAYMENT_PENDING','COMPLETED','FAILED','COMPENSATED'))
transactions_amount_positive: CHECK (amount > 0)
transactions_accounts_differ: CHECK (source_account <> target_account)
transactions_scenario_known: CHECK (payment_scenario IS NULL OR payment_scenario IN ('APPROVE','REJECT','TRANSIENT_FAILURE','TIMEOUT'))'''
}

Table transaction_events {
  id bigserial [pk, not null]
  transaction_id uuid [not null]
  event_type varchar(100) [not null]
  payload jsonb [not null]
  received_at timestamptz [not null, default: `now()`]

  indexes {
    (transaction_id, id) [name: 'transaction_events_transaction_idx']
  }

  Note: '''Registro local de Transaction Service.'''
}

Table processed_messages {
  message_id uuid [pk, not null]
  message_type varchar(120) [not null]
  transaction_id uuid [not null]
  outcome varchar(30) [not null]
  processed_at timestamptz [not null, default: `now()`]

  Note: '''Deduplicación local. La clave real depende del servicio: message_id, par con consumer o idempotency_key/message_type.'''
}

Table transaction_aliases {
  requested_transaction_id uuid [pk, not null]
  transaction_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (transaction_id) [name: 'transaction_aliases_target_idx']
  }

  Note: '''Registro local de Transaction Service.'''
}

Table outbox_messages {
  id bigserial [pk, not null]
  transaction_id uuid [not null]
  exchange varchar(120) [not null]
  routing_key varchar(200) [not null]
  envelope jsonb [not null]
  dispatch_status varchar(20) [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  trace_context varchar(80)

  indexes {
    (id) [name: 'outbox_messages_pending_idx', note: "WHERE dispatch_status = 'PENDING'"]
  }

  Note: '''Bandeja transaccional. En Payment, payment_id permite NULL para eventos interbancarios sin fila payments; la FK local sigue existiendo.

Restricciones SQL:
outbox_messages_status_known: CHECK (dispatch_status IN ('PENDING','DISPATCHED'))'''
}

Table transaction_transitions {
  id bigserial [pk, not null]
  transaction_id uuid [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  event_type varchar(120) [not null]
  failure_reason text
  message_id uuid
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (transaction_id, id) [name: 'transaction_transitions_transaction_idx']
    (transaction_id, message_id) [unique, name: 'transaction_transitions_message_once', note: "WHERE message_id IS NOT NULL"]
  }

  Note: '''Registro local de Transaction Service.

Restricciones SQL:
transaction_transitions_to_known: CHECK (to_status IN ('PENDING','DEBITING','PAYMENT_PENDING','COMPLETED','FAILED','COMPENSATED'))
transaction_transitions_from_known: CHECK (from_status IS NULL OR from_status IN ('PENDING','DEBITING','PAYMENT_PENDING','COMPLETED','FAILED','COMPENSATED'))'''
}

Table schema_migrations {
  name varchar(120) [pk, not null]
  applied_at timestamptz [not null, default: `now()`]

  Note: '''Infraestructura del migrador, no entidad de dominio. Se crea fuera de MIGRATIONS antes de aplicarlas; una tabla en cada base.'''
}

Ref: transaction_events.transaction_id > transactions.transaction_id [delete: no action]
Ref: transaction_aliases.transaction_id > transactions.transaction_id [delete: no action]
Ref: outbox_messages.transaction_id > transactions.transaction_id [delete: no action]
Ref: transaction_transitions.transaction_id > transactions.transaction_id [delete: no action]
