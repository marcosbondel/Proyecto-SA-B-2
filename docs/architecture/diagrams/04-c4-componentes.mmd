C4Component

title Diagrama de Componentes - Transaction Service (C4 Nivel 3)
%% Microservicio descompuesto: Transaction Service (participa en la Saga de transferencia)
%% Cada componente lleva el nombre de la clase o del módulo que existe en
%% apps/services/transaction-service/src. El cliente AMQP no vive aquí: es
%% MessageBroker, del paquete compartido @bank/messaging.
%% Debe coincidir con el .puml equivalente en TODAS las etiquetas.

Container_Ext(rabbitmq, "RabbitMQ", "RabbitMQ 4.3.4-management / AMQP", "Broker central de mensajería asíncrona.")
ContainerDb_Ext(transaction_db, "Transaction DB", "PostgreSQL", "Base exclusiva de Transaction Service: transactions, transaction_events, processed_messages, transaction_aliases, outbox_messages.")

Boundary(messaging, "apps/packages/messaging - @bank/messaging (paquete compartido)") {
    Component(broker, "MessageBroker", "Cliente AMQP compartido", "Conexión y reconexión, suscripción por cola, ack manual, escalera de reintentos y DLQ | AMQP")
}

Container_Boundary(transactionService, "Transaction Service (NestJS)") {

    Boundary(interfaces, "interfaces/") {
        Component(router, "InboundMessageRouter", "Router de mensajes", "Entrega cada envelope al handler que reclama su messageType | llamada interna | síncrono")
        Component(h_transfer, "RequestTransferHandler", "Handler AMQP", "Consume transfer.requested | AMQP | comando")
        Component(h_saga, "SagaEventHandler (x7, fábrica sagaHandlers)", "Handler AMQP", "Consume account.debited, account.debit.rejected, payment.succeeded, payment.failed, account.credited, account.credit.rejected, account.debit.compensated | AMQP | eventos")
        Component(h_status, "TransactionStatusHandler", "Handler AMQP", "Consume transaction.status.requested | AMQP | comando (request/reply)")
        Component(h_list, "TransactionListHandler", "Handler AMQP", "Consume transaction.list.query | AMQP | comando (request/reply)")
        Component(h_stats, "TransactionStatsHandler", "Handler AMQP", "Consume transaction.stats.query | AMQP | comando (request/reply)")
        Component(health, "HealthController", "Controlador HTTP", "/health y /ready responden preguntas distintas | HTTP | síncrono")
    }

    Boundary(application, "application/") {
        Component(uc_request_transfer, "RequestTransferUseCase", "Caso de uso", "Abre la Saga: crea la Transaction en PENDING; invariantes T-1 a T-4")
        Component(saga, "AdvanceSagaUseCase", "Caso de uso", "Un paso de la Saga, sea cual sea: aplica el evento y arma el comando/evento que la transición implica")
        Component(uc_get_status, "GetTransactionStatusUseCase", "Caso de uso", "Responde transaction.status.replied")
        Component(uc_list, "ListTransactionsUseCase", "Caso de uso", "Responde transaction.list.replied; el alcance se decide desde la identidad del envelope")
        Component(uc_stats, "GetTransactionStatsUseCase", "Caso de uso", "Responde transaction.stats.replied con los conteos de los dashboards")
        Component(port_repo, "TransactionRepository", "Puerto (interfaz, application/ports.ts)", "Contrato de persistencia: start, applyEvent, dispatchPendingOutbox, list, stats")
        Component(port_publisher, "EventPublisher", "Puerto (interfaz, application/ports.ts)", "Contrato de publicación: send, publish, reply y envelopeFor (arma sin enviar)")
    }

    Boundary(domain, "domain/") {
        Component(transaction, "Transaction + applyEvent", "Entidad + máquina de estados", "PENDING/DEBITING/PAYMENT_PENDING/COMPLETED/FAILED/COMPENSATED; invariantes T-1 a T-7")
        Component(money, "Money", "Objeto de valor", "Monto en unidades menores de GTQ; nunca un float")
    }

    Boundary(infrastructure, "infrastructure/") {
        Component(repo_impl, "PostgresTransactionRepository", "Adaptador de persistencia", "Implementa TransactionRepository sobre PostgreSQL: deduplica por messageId, decide bajo lock de fila y escribe el outbox en la misma transacción")
        Component(pub_adapter, "BrokerEventPublisher", "Adaptador de publicación", "Implementa EventPublisher: valida contra @bank/contracts y arma el envelope de seguimiento (correlationId e identidad)")
        Component(outbox, "OutboxRelay", "Relay del outbox (infrastructure/scheduler/outbox.scheduler.ts)", "Barre outbox_messages PENDING con FOR UPDATE SKIP LOCKED y publica el envelope guardado tal cual")
    }
}

Rel(rabbitmq, broker, "entrega transfer.requested, transaction.status.requested, transaction.list.query, transaction.stats.query, account.debited, account.debit.rejected, payment.succeeded, payment.failed, account.credited, account.credit.rejected, account.debit.compensated | AMQP | comandos/eventos | correlationId")
Rel(broker, rabbitmq, "conexión AMQP, ack manual, reintentos y DLQ | AMQP | conexión")
Rel(broker, rabbitmq, "publica account.debit.requested, payment.requested, account.credit.requested, account.debit.compensation.requested, transaction.initiated, transaction.completed, transaction.failed, transaction.compensated, transaction.status.replied, transaction.list.replied, transaction.stats.replied | AMQP | comandos/eventos/respuestas | correlationId")

Rel(broker, router, "entrega el envelope ya parseado | llamada interna | síncrono")
Rel(router, h_transfer, "enruta por messageType | llamada interna | síncrono")
Rel(router, h_saga, "enruta por messageType | llamada interna | síncrono")
Rel(router, h_status, "enruta por messageType | llamada interna | síncrono")
Rel(router, h_list, "enruta por messageType | llamada interna | síncrono")
Rel(router, h_stats, "enruta por messageType | llamada interna | síncrono")

Rel(h_transfer, uc_request_transfer, "invoca | llamada interna | síncrono")
Rel(h_saga, saga, "invoca | llamada interna | síncrono")
Rel(h_status, uc_get_status, "invoca | llamada interna | síncrono")
Rel(h_list, uc_list, "invoca | llamada interna | síncrono")
Rel(h_stats, uc_stats, "invoca | llamada interna | síncrono")

Rel(uc_request_transfer, transaction, "crea/valida T-1 a T-4 | llamada interna | síncrono")
Rel(uc_request_transfer, saga, "ordena el primer paso (DEBIT_ORDERED) por el mismo camino que los demás | llamada interna | síncrono")
Rel(saga, transaction, "aplica la transición válida T-5, T-6, T-7 | llamada interna | síncrono")
Rel(transaction, money, "valida monto y precisión | llamada interna | síncrono")

Rel(uc_request_transfer, port_repo, "persiste la transacción y registra el alias de un reintento | llamada interna | síncrono")
Rel(uc_request_transfer, port_publisher, "publica transaction.initiated | llamada interna | síncrono")
Rel(uc_get_status, port_repo, "lee la transacción y su rastro de pago | llamada interna | síncrono")
Rel(uc_get_status, port_publisher, "responde transaction.status.replied | llamada interna | síncrono")
Rel(uc_list, port_repo, "lee una página de transacciones ya acotada | llamada interna | síncrono")
Rel(uc_list, port_publisher, "responde transaction.list.replied | llamada interna | síncrono")
Rel(uc_stats, port_repo, "lee los conteos | llamada interna | síncrono")
Rel(uc_stats, port_publisher, "responde transaction.stats.replied | llamada interna | síncrono")
Rel(saga, port_repo, "persiste la transición y su outbox en una sola transacción | llamada interna | síncrono")
Rel(saga, port_publisher, "envelopeFor: arma payment.requested, account.credit.requested, account.debit.compensation.requested, transaction.completed, transaction.failed, transaction.compensated para el outbox | llamada interna | síncrono")

Rel(repo_impl, port_repo, "implementa | interfaz")
Rel(pub_adapter, port_publisher, "implementa | interfaz")

Rel(repo_impl, transaction_db, "lee/escribe transactions, transaction_events, processed_messages, transaction_aliases y outbox_messages | TCP/IP | acceso a datos")
Rel(outbox, port_repo, "dispatchPendingOutbox: toma un lote PENDING y lo marca despachado | llamada interna | síncrono")
Rel(outbox, broker, "publica cada envelope guardado, sin reconstruirlo | llamada interna | síncrono")
Rel(pub_adapter, broker, "publica lo que no pasa por el outbox: transaction.initiated y las respuestas | llamada interna | síncrono")

UpdateElementStyle(rabbitmq, $bgColor="white", $borderColor="#1168BD", $fontColor="#1168BD")
UpdateElementStyle(transaction_db, $bgColor="white", $borderColor="#1168BD", $fontColor="#1168BD")
UpdateElementStyle(transaction, $bgColor="white", $borderColor="#398819", $fontColor="#398819")
UpdateElementStyle(money, $bgColor="white", $borderColor="#398819", $fontColor="#398819")
