{
  "name": "@bank/messaging",
  "version": "0.0.0",
  "private": true,
  "description": "Technical RabbitMQ adapter for the Bank USAC system: connect, reconnect, publish and consume. Knows no business event names.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bank/contracts": "workspace:*",
    "amqp-connection-manager": "catalog:",
    "amqplib": "catalog:"
  },
  "devDependencies": {
    "@bank/tooling": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  }
}
