# Bank USAC — account-service
#
# Names and placeholders only. Real credentials never enter the repository
# (docs/SECURITY.md). Copy this file to `.env` and fill in local values.

# Runtime mode: development | test | production
NODE_ENV=development

# Port for this service's health and readiness endpoints. The service exposes
# no business HTTP surface: it talks to the rest of the system over RabbitMQ
# only (constitution IV).
PORT=3002

# This service's OWN database. It must not point at another service's database
# (constitution II). The engine runs outside the cluster (constitution III);
# the local stack arrives with T-06 on PostgreSQL 18.4.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/bank_account

# RabbitMQ connection string. Version 4.3.4 is the pinned reference for T-06.
RABBITMQ_URL=amqp://<user>:<password>@localhost:5672

# --------------------------------------------------------------- deactivation
# The automatic process the assignment requires (§4.1, p. 4): accounts inactive
# for six months with a balance below Q50.00 are deactivated. Every value below
# defaults to what the assignment specifies, so an unconfigured deployment
# behaves as written; they exist because a demonstration cannot wait six months.

# Only an explicit `false` turns the job off. Absent means on.
DEACTIVATION_ENABLED=true

# How often it runs. 86400000 ms is one day.
DEACTIVATION_INTERVAL_MS=86400000

# "Tras 6 meses" — six calendar months, not 180 days.
INACTIVITY_MONTHS=6

# "Balance menor a Q50.00" — 5000 centavos, strictly below. Exactly Q50.00 is
# not deactivated.
INACTIVITY_MIN_BALANCE_MINOR=5000
