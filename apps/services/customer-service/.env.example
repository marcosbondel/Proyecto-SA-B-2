# Bank USAC — customer-service
#
# Names and placeholders only. Real credentials never enter the repository
# (docs/SECURITY.md). Copy this file to `.env` and fill in local values.

# Runtime mode: development | test | production
NODE_ENV=development

# Port for this service's health and readiness endpoints. The service exposes
# no business HTTP surface: it talks to the rest of the system over RabbitMQ
# only (constitution IV).
PORT=3001

# This service's OWN database. It must not point at another service's database
# (constitution II). The engine runs outside the cluster (constitution III);
# the local stack arrives with T-06 on PostgreSQL 18.4.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/bank_customer

# RabbitMQ connection string. Version 4.3.4 is the pinned reference for T-06.
RABBITMQ_URL=amqp://<user>:<password>@localhost:5672

# -----------------------------------------------------------------------------
# Object storage (MinIO). The identity-document photo travels through it, never
# through the broker (ADR-012): the Gateway uploads the bytes and publishes a
# reference; this service fetches them and recomputes the digest before it
# trusts anything. Same bucket as the Gateway's, so the same names.
# -----------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=http://localhost:9002
OBJECT_STORAGE_ACCESS_KEY=<minio-app-user>
OBJECT_STORAGE_SECRET_KEY=<minio-app-password>
OBJECT_STORAGE_BUCKET=customer-identity-documents
OBJECT_STORAGE_REGION=us-east-1
