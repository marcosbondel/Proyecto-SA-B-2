# Bank USAC — payment-service
#
# Names and placeholders only. Real credentials never enter the repository
# (docs/SECURITY.md). Copy this file to `.env` and fill in local values.

# Runtime mode: development | test | production
NODE_ENV=development

# Port for this service's health and readiness endpoints. The service exposes
# no business HTTP surface: it talks to the rest of the system over RabbitMQ
# only (constitution IV).
PORT=3004

# This service's OWN database. It must not point at another service's database
# (constitution II). The engine runs outside the cluster (constitution III);
# the local stack arrives with T-06 on PostgreSQL 18.4.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/bank_payment

# RabbitMQ connection string. Version 4.3.4 is the pinned reference for T-06.
RABBITMQ_URL=amqp://<user>:<password>@localhost:5672

# --- The retry ladder (T-19 backend) --------------------------------------
# Milliseconds between payment attempts, comma-separated. The default is the
# ladder docs/events/topology.md fixed for the broker's own retries — 1 s, 5 s,
# 30 s — so four attempts at most.
#
# An empty value is legal and means one attempt with no ladder, which is the
# shape a real provider with its own internal retries would want.
PAYMENT_RETRY_DELAYS_MS=1000,5000,30000

# How often the sweeper looks for attempts the ladder owes. It bounds how late
# a retry can be, so keep it well under the smallest rung.
PAYMENT_RETRY_SWEEP_MS=500

# --- Outbox -----------------------------------------------------------------------
# Milliseconds between relays of the outbox to the broker.
OUTBOX_RELAY_MS=200

# --- Provider failure simulation (Fase 3) -----------------------------------
# Initial values. Changed at run time, without a restart, through
# PUT /api/payments/simulation (ADMINISTRADOR role) on the gateway.
PAYMENT_SIM_FAILURE_RATE=0
PAYMENT_SIM_TIMEOUT_RATE=0
PAYMENT_SIM_LATENCY_MS=0

# --- Interbank deposits, official contract v1 (T-60) ------------------------
# Agreement: github.com/marcosbondel/bank-interbank-contract (AGREEMENT.md).
INTERBANK_BANK_CODE=BANK02
INTERBANK_PARTNER_BANK_CODE=BANK99

# Partner bank base URL, including /interbank/v1. The callback URL is derived
# from it ({base}/transfers/{id}/result), never configured. Empty disables
# sending. Local mock: http://localhost:3021/interbank/v1.
INTERBANK_PARTNER_BASE_URL=

# The key we SEND in `X-Api-Key` to the partner bank (>= 32 characters).
# Empty with a base URL set = the service logs an ERROR at boot and every send
# is declined instead of going out unauthenticated. Never commit a real one.
INTERBANK_API_KEY_OUTBOUND=

# Maximum amount per operation, in centavos, applied to sending and receiving.
# The contract caps it at 10000.00 (1000000).
INTERBANK_MAX_AMOUNT_MINOR=1000000

# Milliseconds between retries of the TIMEOUT protocol's resolution steps.
# The deadlines themselves (180 s, then +300 s) come from the contract, not
# from configuration.
INTERBANK_RESOLVE_RETRY_MS=5000

# --- Telemetry (Fase 3, @bank/observability) ------------------------------
# OTLP/HTTP endpoint of the OpenTelemetry Collector. Empty = traces and metrics
# are not exported (logs still go to stdout as JSON, where the log agent reads
# them). Locally with the observability stack: http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=

# `environment` and `version` of every log line, span and metric. In the cluster
# the chart sets them from the namespace (dev / prod) and the image tag.
DEPLOYMENT_ENVIRONMENT=local
SERVICE_VERSION=dev

# debug | info | warn | error
LOG_LEVEL=info
