{
  "$comment": "GENERADO por scripts/sync-contract.mjs a partir de docs/references/interbank-contract-v1.openapi.yaml. No editar a mano.",
  "source": "docs/references/interbank-contract-v1.openapi.yaml",
  "sha256": "4888b951aa48f95d8d301098c8aa642adfaa0e45a380975b8ce42acf3506df6a",
  "schemas": {
    "BankCode": {
      "type": "string",
      "description": "Código asignado a cada banco por el curso.",
      "pattern": "^BANK[0-9]{2}$",
      "example": "BANK03"
    },
    "AccountNumber": {
      "type": "string",
      "description": "Número de cuenta en el formato del banco dueño de la cuenta (publicado en el acuerdo de integración).",
      "pattern": "^[A-Za-z0-9-]{1,34}$",
      "example": "3001-000123"
    },
    "Amount": {
      "type": "string",
      "description": "Monto con dos decimales, como texto para evitar errores de punto flotante. Entre 0.01 y 10000.00.",
      "pattern": "^[0-9]{1,5}\\.[0-9]{2}$",
      "example": "150.00"
    },
    "Currency": {
      "type": "string",
      "enum": [
        "GTQ"
      ]
    },
    "ReasonCode": {
      "type": "string",
      "description": "Motivo de un rechazo.",
      "enum": [
        "ACCOUNT_NOT_FOUND",
        "ACCOUNT_INACTIVE",
        "AMOUNT_LIMIT_EXCEEDED",
        "CURRENCY_NOT_SUPPORTED",
        "EXPIRED",
        "CANCELLED",
        "PROCESSING_ERROR"
      ]
    },
    "TransferRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interbankTransferId",
        "originBankCode",
        "destinationBankCode",
        "originAccount",
        "destinationAccount",
        "amount",
        "currency",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "interbankTransferId": {
          "type": "string",
          "format": "uuid",
          "description": "Id único generado por el banco emisor."
        },
        "originBankCode": {
          "$ref": "#/components/schemas/BankCode"
        },
        "destinationBankCode": {
          "$ref": "#/components/schemas/BankCode"
        },
        "originAccount": {
          "$ref": "#/components/schemas/AccountNumber"
        },
        "destinationAccount": {
          "$ref": "#/components/schemas/AccountNumber"
        },
        "amount": {
          "$ref": "#/components/schemas/Amount"
        },
        "currency": {
          "$ref": "#/components/schemas/Currency"
        },
        "description": {
          "type": "string",
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "createdAt + 180 segundos."
        }
      }
    },
    "TransferAck": {
      "type": "object",
      "required": [
        "interbankTransferId",
        "status",
        "receivedAt"
      ],
      "properties": {
        "interbankTransferId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "PROCESSING"
          ]
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "TransferStatus": {
      "type": "object",
      "required": [
        "interbankTransferId",
        "status",
        "updatedAt"
      ],
      "properties": {
        "interbankTransferId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "description": "Estado en el banco receptor.",
          "enum": [
            "PROCESSING",
            "ACCEPTED",
            "REJECTED",
            "CANCELLED"
          ]
        },
        "reasonCode": {
          "$ref": "#/components/schemas/ReasonCode"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "TransferResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interbankTransferId",
        "destinationBankCode",
        "status",
        "processedAt"
      ],
      "properties": {
        "interbankTransferId": {
          "type": "string",
          "format": "uuid"
        },
        "destinationBankCode": {
          "$ref": "#/components/schemas/BankCode"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "reasonCode": {
          "$ref": "#/components/schemas/ReasonCode"
        },
        "reasonMessage": {
          "type": "string",
          "maxLength": 200
        },
        "processedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "CallbackAck": {
      "type": "object",
      "required": [
        "interbankTransferId",
        "received"
      ],
      "properties": {
        "interbankTransferId": {
          "type": "string",
          "format": "uuid"
        },
        "received": {
          "type": "boolean"
        }
      }
    },
    "CancelRequest": {
      "type": "object",
      "required": [
        "originBankCode",
        "reason"
      ],
      "properties": {
        "originBankCode": {
          "$ref": "#/components/schemas/BankCode"
        },
        "reason": {
          "type": "string",
          "enum": [
            "TIMEOUT",
            "CLIENT_REQUEST"
          ]
        }
      }
    },
    "CancelResponse": {
      "type": "object",
      "required": [
        "interbankTransferId",
        "result"
      ],
      "properties": {
        "interbankTransferId": {
          "type": "string",
          "format": "uuid"
        },
        "result": {
          "type": "string",
          "description": "CANCELLED: no se acreditó y ya no se acreditará. ALREADY_ACCEPTED: ya se acreditó, el emisor confirma el débito.\nALREADY_REJECTED: ya se había rechazado, el emisor libera la reserva.\n",
          "enum": [
            "CANCELLED",
            "ALREADY_ACCEPTED",
            "ALREADY_REJECTED"
          ]
        }
      }
    },
    "ReversalRequest": {
      "type": "object",
      "required": [
        "reversalId",
        "originalTransferId",
        "originBankCode",
        "amount",
        "currency"
      ],
      "properties": {
        "reversalId": {
          "type": "string",
          "format": "uuid"
        },
        "originalTransferId": {
          "type": "string",
          "format": "uuid",
          "description": "interbankTransferId del depósito que se debe devolver."
        },
        "originBankCode": {
          "$ref": "#/components/schemas/BankCode"
        },
        "amount": {
          "$ref": "#/components/schemas/Amount"
        },
        "currency": {
          "$ref": "#/components/schemas/Currency"
        }
      }
    },
    "ReversalStatus": {
      "type": "object",
      "required": [
        "reversalId",
        "status"
      ],
      "properties": {
        "reversalId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "description": "COMPLETED incluye el id del depósito de devolución enviado al emisor.",
          "enum": [
            "PROCESSING",
            "COMPLETED",
            "FAILED"
          ]
        },
        "refundTransferId": {
          "type": "string",
          "format": "uuid"
        },
        "reasonMessage": {
          "type": "string"
        }
      }
    },
    "ReconciliationPage": {
      "type": "object",
      "required": [
        "date",
        "items",
        "page",
        "pageSize",
        "totalItems"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "page": {
          "type": "integer"
        },
        "pageSize": {
          "type": "integer"
        },
        "totalItems": {
          "type": "integer"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "interbankTransferId",
              "amount",
              "currency",
              "status",
              "updatedAt"
            ],
            "properties": {
              "interbankTransferId": {
                "type": "string",
                "format": "uuid"
              },
              "amount": {
                "$ref": "#/components/schemas/Amount"
              },
              "currency": {
                "$ref": "#/components/schemas/Currency"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PROCESSING",
                  "ACCEPTED",
                  "REJECTED",
                  "CANCELLED"
                ]
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "timestamp"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_ERROR",
            "UNAUTHORIZED",
            "NOT_FOUND",
            "IDEMPOTENCY_CONFLICT",
            "EXPIRED",
            "SERVICE_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
