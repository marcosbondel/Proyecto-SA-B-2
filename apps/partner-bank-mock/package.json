{
  "name": "partner-bank-mock",
  "version": "0.0.0",
  "private": true,
  "description": "Banco pareja simulado: implementa el contrato interbancario oficial v1 en los dos roles (receptor y emisor), con inyeccion de fallos en caliente",
  "type": "module",
  "scripts": {
    "build": "node scripts/check-syntax.mjs && node scripts/sync-contract.mjs --check",
    "contract:sync": "node scripts/sync-contract.mjs",
    "dev": "node --env-file-if-exists=../../infra/docker/.env server.mjs",
    "start": "node server.mjs",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "typecheck": "node scripts/check-syntax.mjs"
  },
  "devDependencies": {
    "@bank/tooling": "workspace:*",
    "eslint": "catalog:",
    "yaml": "catalog:"
  }
}
