# Bank USAC — API Gateway
#
# Names and placeholders only. Real credentials never enter the repository
# (docs/SECURITY.md). Copy this file to `.env` and fill in local values.

# Runtime mode: development | test | production
NODE_ENV=development

# HTTP port for the only external entry point of the system.
PORT=3000

# RabbitMQ connection string used to publish commands and consume replies.
RABBITMQ_URL=amqp://<user>:<password>@localhost:5672

# The gateway declares no DATABASE_URL on purpose: it never reads a database
# (constitution V). Domain data is owned by the services.
