# Bank USAC — API Gateway
#
# Names and placeholders only. Real credentials never enter the repository
# (docs/SECURITY.md). Copy this file to `.env` and fill in local values.

# Runtime mode: development | test | production
NODE_ENV=development

# HTTP port for the only external entry point of the system.
PORT=3000

# RabbitMQ connection string used to publish commands and consume replies.
RABBITMQ_URL=amqp://<user>:<password>@localhost:5672

# The gateway declares no DATABASE_URL on purpose: it never reads a database
# (constitution V). Domain data is owned by the services.

# --- Session tokens (ADR-010) ---------------------------------------------
# HS256 signing secret. The gateway is both the only signer and the only
# validator, so this never leaves the process. Minimum 32 characters: HS256
# with a short secret is brute-forceable offline from a single issued token.
JWT_SECRET=<at-least-32-characters-of-random-secret>

# Seconds. One hour, fixed by ADR-010, which also rules out refresh tokens.
JWT_EXPIRES_IN=3600

# --- Asynchronous request/reply -------------------------------------------
# Names this replica's private reply queue (gateway.replies.<id>). Defaults to
# a per-process UUID. Never share one value across replicas: a shared durable
# queue would have the broker deliver a reply to an instance that never asked.
GATEWAY_INSTANCE_ID=

# Milliseconds a reply is waited for. Five seconds, fixed by T-05. It is
# configurable so a test can shorten it, not so an operator can tune it.
REPLY_TIMEOUT_MS=5000

# --- Object storage for the identity-document photo (ADR-012) -------------
# MinIO, S3-compatible. This bucket is a transfer buffer: it holds no business
# state and nobody queries it to decide anything. The photo's owner remains
# Customer Service. These are NOT database credentials.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=<minio-app-user>
OBJECT_STORAGE_SECRET_KEY=<minio-app-password>
OBJECT_STORAGE_BUCKET=customer-identity-documents
OBJECT_STORAGE_REGION=us-east-1
