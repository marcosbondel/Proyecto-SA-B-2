# Bank USAC — web
#
# Names and placeholders only. Real values never enter the repository
# (docs/SECURITY.md). Copy this file to `.env` and fill in local values.

# Runtime mode: development | production
NODE_ENV=development

# The browser application's own port.
#
# Deliberately outside the 3000-3005 range: the Gateway owns 3000 and the five
# domain services own 3001-3005 (customer-service is 3001). Nuxt defaults to
# 3000, so leaving this unset collides with the Gateway on the first run.
PORT=3010

# Base URL of the API Gateway — the only entry point the browser may call
# (constitution V). Nuxt exposes NUXT_PUBLIC_* to the client bundle, so never
# put a secret behind this prefix.
#
# Required from T-15 onward: the shell now signs in, attaches the session token
# and renders the five error states against this address. It is read through
# runtime config, never compiled in, so one build serves every environment.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Grafana origin, for the traceId links (opens the trace in Grafana Explore on
# Tempo). Empty = the traceId stays copyable text. Locally, after
# `pnpm obs:forward`: http://localhost:3002. Public, so never a secret.
NUXT_PUBLIC_GRAFANA_URL=
